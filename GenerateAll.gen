#!/usr/bin/env node
const { spawnSync } = require("node:child_process");
const path = require("node:path");

const dir = __dirname;
const args = process.argv.slice(2);
const scripts = [
  "ItemNames.gen",
  "ItemDescriptionSources.gen",
  "BuffNames.gen",
  "ConsumableBuffBridge.gen",
  "DamageAttrIdName.gen",
  "SkillAoyiIcons.gen",
  "RecountTable.gen",
  "MonsterNames.gen",
  "SceneNames.gen",
  "SkillNames.gen",
  "SkillTagLabels.gen",
  "SkillCooldowns.gen",
  "SkillDamageChainBridge.gen",
  "ClassSpecSkillModelProbe.gen",
  "ClassLabels.gen",
  "SkillBreakdownDetails.gen",
  "SeasonTalentNodeProbe.gen",
  "SeasonEffectDescriptions.gen",
  "SeasonRogueEntryProbe.gen",
  "SeasonPhantomFactorProbe.gen",
  "TalentEffectModelProbe.gen",
  "TalentSpecOwnership.gen",
  "SeasonPhantomFactors.gen",
  "LinkTextDescriptions.gen",
  "EffectSources.gen",
  "ModifierSourceIndex.gen",
  "ModifierObservedUidBridge.gen",
  "ModifierDisplayTable.gen",
  "ModifierDescriptions.gen",
  "ModifierRecountTable.gen",
  "ModifierClassificationTable.gen",
  "ModifierContributionTable.gen",
  "LuckyStrikeRuntime.gen",
  "ModifierDescriptionCatalogs.gen",
  "ModifierFormulaTermTable.gen",
  "ModifierValueProofTable.gen",
  "EffectDescriptionSurfaceProbe.gen",
  "EffectPredicateAudit.gen",
  "EffectComponentWorklist.gen",
  "ExtractIcons.gen",
  "ExportIconPngs.gen",
  "ExportParserAssets.gen"
];

for (const script of scripts) {
  console.log("");
  console.log(`=== ${script} ===`);
  const result = spawnSync(process.execPath, [path.join(dir, script), ...args], {
    stdio: "inherit",
    cwd: dir
  });
  if (result.status !== 0) {
    process.exit(result.status || 1);
  }
}
