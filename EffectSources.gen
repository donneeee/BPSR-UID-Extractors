function readJson(filePath, fallback = null) {
  if (!fs.existsSync(filePath)) return fallback;
  return JSON.parse(fs.readFileSync(filePath, "utf8"));
}

function toNumber(value) {
  const numberValue = Number(value);
  return Number.isFinite(numberValue) ? numberValue : null;
}

function uniqueNumbers(values) {
  return [...new Set((values ?? []).map(toNumber).filter((value) => value !== null))]
    .sort((left, right) => left - right);
}

function uniqueStrings(values) {
  return [...new Set((values ?? []).map(String).filter(Boolean))]
    .sort((left, right) => left.localeCompare(right));
}

function stripUndefined(value) {
  if (Array.isArray(value)) {
    return value.map(stripUndefined).filter((entry) => entry !== undefined);
  }
  if (value && typeof value === "object") {
    const out = {};
    for (const [key, entry] of Object.entries(value)) {
      if (entry === undefined || entry === null || entry === "") continue;
      const cleaned = stripUndefined(entry);
      if (cleaned !== undefined && (!Array.isArray(cleaned) || cleaned.length)) {
        out[key] = cleaned;
      }
    }
    return Object.keys(out).length ? out : undefined;
  }
  return value;
}

function preferredName(names, fallback = "") {
  return names?.en || names?.["zh-CN"] || names?.design || fallback || "";
}

function buildDescriptionModifierEvidence({
  source,
  valueStatus,
  descriptionId,
  cleanDescriptions,
}) {
  const cleanDescription = preferredText(cleanDescriptions);
  if (!cleanDescription) return undefined;
  return stripUndefined({
    source,
    valueStatus,
    descriptionId: toNumber(descriptionId),
    cleanDescription,
    valueTexts: extractFormulaValueTexts(cleanDescription),
  });
}

function normalizedNames(names, fallback = "") {
  const out = {};
  for (const [locale, value] of Object.entries(names ?? {})) {
    const text = String(value || "").trim();
    if (text) out[locale] = text;
  }
  if (!Object.keys(out).length && fallback) out.en = fallback;
  return out;
}

function mergeNameMaps(target, incoming) {
  const merged = { ...(target ?? {}) };
  for (const [locale, value] of Object.entries(incoming ?? {})) {
    const text = String(value || "").trim();
    if (text && !merged[locale]) merged[locale] = text;
  }
  return Object.keys(merged).length ? merged : undefined;
}

function mergeDescriptionMaps(target, incoming) {
  return mergeNameMaps(target, incoming);
}

function localeText(values, locale) {
  if (!values) return "";
  if (typeof values === "string") return values;
  if (Array.isArray(values)) {
    return values.map((entry) => localeText(entry, locale)).filter(Boolean).join(" ");
  }
  return values[locale]
    ?? values.en
    ?? values["zh-CN"]
    ?? Object.values(values).find((entry) => typeof entry === "string" && entry.trim())
    ?? "";
}

function collectLinkTextIdsFromText(text) {
  const ids = [];
  const regex = /<linktext=(\d+)[^>]*>/gi;
  for (const match of String(text || "").matchAll(regex)) {
    const id = toNumber(match[1]);
    if (id !== null) ids.push(id);
  }
  return ids;
}

function collectLinkTextIdsFromDescriptions(descriptions) {
  return uniqueNumbers(Object.values(descriptions ?? {}).flatMap(collectLinkTextIdsFromText));
}

function appendUniqueText(base, addition) {
  const left = String(base || "").trim();
  const right = String(addition || "").trim();
  if (!right) return left || undefined;
  if (!left) return right;
  const normalizedLeft = cleanMarkup(left).toLowerCase();
  const normalizedRight = cleanMarkup(right).toLowerCase();
  if (normalizedLeft.includes(normalizedRight)) return left;
  return `${left}\n\n${right}`;
}

function tooltipDescriptionLine(tooltip, localeId, clean = false) {
  const names = tooltip?.names;
  const descriptions = clean ? tooltip?.cleanDescriptions : tooltip?.descriptions;
  const name = localeText(names, localeId);
  const description = localeText(descriptions, localeId);
  const text = clean ? cleanMarkup(description) : String(description || "").trim();
  if (!text) return "";
  const label = clean ? cleanMarkup(name) : String(name || "").trim();
  if (!label || cleanMarkup(text).toLowerCase().startsWith(cleanMarkup(label).toLowerCase())) return text;
  return `${label}: ${text}`;
}

function appendTooltipDescriptions(baseDescriptions, tooltips, clean = false) {
  const out = { ...(baseDescriptions ?? {}) };
  for (const localeId of LOCALES) {
    let value = out[localeId];
    for (const tooltip of tooltips) {
      value = appendUniqueText(value, tooltipDescriptionLine(tooltip, localeId, clean));
    }
    if (value) out[localeId] = value;
  }
  return Object.keys(out).length ? out : undefined;
}

function enrichSourcesWithLinkedTooltips(builder, linkTextDescriptions) {
  const byId = linkTextDescriptions?.linkTextsById ?? {};
  let enrichedSources = 0;
  let linkedTooltips = 0;
  for (const source of Object.values(builder.effectSourcesById)) {
    const linkTextIds = collectLinkTextIdsFromDescriptions(source.descriptions);
    if (linkTextIds.length === 0) continue;
    const tooltips = linkTextIds
      .map((id) => byId[String(id)])
      .filter((entry) => entry?.description || entry?.descriptions || entry?.cleanDescriptions);
    if (tooltips.length === 0) continue;

    enrichedSources += 1;
    linkedTooltips += tooltips.length;
    source.descriptions = appendTooltipDescriptions(source.descriptions, tooltips, false);
    source.cleanDescriptions = appendTooltipDescriptions(source.cleanDescriptions, tooltips, true);
    source.linkTextTooltips = tooltips.map((tooltip) => stripUndefined({
      linkTextId: tooltip.linkTextId,
      name: tooltip.name,
      names: tooltip.names,
      description: tooltip.description,
      descriptions: tooltip.descriptions,
      cleanDescriptions: tooltip.cleanDescriptions,
      descriptionIds: tooltip.descriptionIds,
      descriptionKey: tooltip.descriptionKey,
      valueTexts: tooltip.valueTexts,
    }));
    source.evidence = mergeEvidence(source.evidence, tooltips.map((tooltip) => stripUndefined({
      source: "LinkTextDescriptions.linkTextTooltip",
      linkTextId: tooltip.linkTextId,
      descriptionKey: tooltip.descriptionKey,
      descriptionIds: tooltip.descriptionIds,
    })));
  }
  builder.linkTextTooltipSummary = { enrichedSources, linkedTooltips };
}

function entityNames(entity, fallback = "") {
  return normalizedNames(entity?.names ?? entity?.Names, entity?.name ?? entity?.Name ?? fallback);
}

function sourceHasBuffIndex(builder, buffId) {
  return Boolean(builder.effectSourcesById[`buff-source:${buffId}`]
    || (builder.buffIdToEffectSourceIds[buffId] ?? []).length);
}

const BATTLE_IMAGINE_PREFIXES = [
  /^Battle Imagine\s*[-:–]\s*/i,
  /^Stunt Battle Imagine\s*[-:–]\s*/i,
  /^Arcane Battle Imagine\s*[-:–]\s*/i,
  /^Battle Fantasy\s*[-:–]\s*/i,
  /^Imagine de combat\s*[-:–]\s*/i,
  /^Kampfvorstellung\s*[-:–]\s*/i,
  /^Imagine de batalla\s*:\s*/i,
  /^Imaginar de Batalha\s*[-:–]\s*/i,
  /^战斗幻想[·・]\s*/,
  /^戰鬥幻想[·・]\s*/,
  /^バトルイマジン[・･]\s*/,
  /^배틀\s*이매진[・･]\s*/,
];

const MONSTER_OWNER_PREFIXES = [
  /^\[?Boss\]?\s*[-:–]\s*/i,
  /^Boss\s*[:：]\s*/i,
  /^Elite\s*[-:–]\s*/i,
  /^\[首领\]\s*/,
  /^\[首領\]\s*/,
  /^首领[·・]\s*/,
  /^首領[·・]\s*/,
  /^精英[·・]\s*/,
  /^ボス[・･]\s*/,
  /^보스[・･]\s*/,
  /^Jefe\s*:\s*/i,
  /^Chefe\s*[:：–-]\s*/i,
];

const OWNER_SUFFIXES = [
  /\s*[-:：–]\s*Resonance$/i,
  /\s*[-:：–]\s*Résonance$/i,
  /\s*[-:：–]\s*Ressonância$/i,
  /\s*[-:：–]\s*共鸣$/,
  /\s*[-:：–]\s*共鳴$/,
  /^共鸣/,
  /^共鳴/,
];

function stripWithPatterns(value, patterns) {
  let text = String(value || "").trim();
  for (const pattern of patterns) {
    text = text.replace(pattern, "").trim();
  }
  return text;
}

function stripBattleImaginePrefix(value) {
  return stripWithPatterns(value, BATTLE_IMAGINE_PREFIXES);
}

function stripOwnerDecorations(value) {
  return stripWithPatterns(value, [...MONSTER_OWNER_PREFIXES, ...OWNER_SUFFIXES]);
}

function normalizeOwnerKey(value) {
  return stripOwnerDecorations(stripBattleImaginePrefix(value))
    .toLowerCase()
    .replace(/[\s"'“”‘’`]+/g, "")
    .replace(/[·・:：/()（）\[\]【】]/g, "")
    .trim();
}

function localizedOwnerName(record, locale) {
  return record?.ownerNames?.[locale]
    || record?.ownerNames?.en
    || record?.ownerNames?.["zh-CN"]
    || record?.ownerNames?.design
    || "";
}

function ownerRecordSort(left, right) {
  return left.priority - right.priority
    || String(left.sourceId ?? "").localeCompare(String(right.sourceId ?? ""));
}

function chooseOwnerRecord(records) {
  return [...records].sort(ownerRecordSort)[0] ?? null;
}

function addOwnerAlias(index, alias, record) {
  const key = normalizeOwnerKey(alias);
  if (!key) return;
  record.aliases.add(key);
  const existing = index.exact.get(key) ?? [];
  existing.push(record);
  index.exact.set(key, existing);
}

function addOwnerRecord(index, record) {
  const existing = index.records.find((row) =>
    row.source === record.source && String(row.sourceId ?? "") === String(record.sourceId ?? "")
  );
  const target = existing ?? record;
  const extraAliases = Array.from(record.aliases ?? []);
  target.aliases ||= new Set();
  if (!existing) index.records.push(target);

  for (const value of Object.values(record.ownerNames ?? {})) {
    addOwnerAlias(index, value, target);
  }
  for (const value of extraAliases) {
    addOwnerAlias(index, value, target);
  }
}

function stripBattleImagineSkillPrefix(value) {
  return String(value || "")
    .trim()
    .replace(/^(?:Arcane|Stunt|Ultimate)\s*!?\s*/i, "")
    .replace(/^(?:奥义|奧義|绝技|絕技)\s*[!！]?\s*/, "")
    .trim();
}

function normalizeOwnerSearchKey(value) {
  return normalizeOwnerKey(value)
    .replace(/[!！,，.。\-—–_]+/g, "")
    .trim();
}

const SOURCE_CONFIG_TOKEN_STOPWORDS = [
  "逻辑",
  "表现",
  "材质",
  "共鸣",
  "出生",
  "通用",
  "寻找目标",
  "主动",
  "被动",
  "效果",
  "自身",
  "生效",
  "触发",
  "记时",
  "计时",
  "监控",
  "隐藏",
  "添加死亡监测",
  "衍生a",
  "衍生b",
  "衍生c",
  "主buff",
  "buff",
  "debuff",
  "宠物",
  "召唤者",
  "极限",
  "当次",
];

function sourceConfigOwnerToken(value) {
  let token = normalizeOwnerSearchKey(stripBattleImagineSkillPrefix(value));
  for (const word of SOURCE_CONFIG_TOKEN_STOPWORDS) {
    token = token.replaceAll(normalizeOwnerSearchKey(word), "");
  }
  return token.trim();
}

function hasUsableSourceConfigOwnerToken(token) {
  if (!token) return false;
  if (token.length < 2) return false;
  return !["加", "减", "目标", "时间", "效果"].includes(token);
}

function aoyiSkillNameKeys(row) {
  return uniqueStrings([
    row.Name,
    row.NameDesign,
    row.DesignName,
    ...Object.values(row.Names ?? {}),
  ])
    .map((value) => normalizeOwnerSearchKey(stripBattleImagineSkillPrefix(value)))
    .filter((value) => value.length >= 2);
}

function aoyiSkillOwnerNames(row, ownerNamesBySkillAlias = new Map()) {
  const directOwnerNames = normalizedNames(row.MonsterNames);
  const linkedOwnerNames = Object.keys(directOwnerNames).length
    ? null
    : aoyiSkillNameKeys(row)
      .map((key) => ownerNamesBySkillAlias.get(key))
      .find(Boolean);
  const names = Object.keys(directOwnerNames).length
    ? directOwnerNames
    : linkedOwnerNames ?? normalizedNames(row.Names, row.NameDesign ?? row.Name);
  return Object.keys(names).length ? names : null;
}

function aoyiSkillAliases(row) {
  const aliases = new Set();
  const add = (value) => {
    const raw = String(value || "").trim();
    if (!raw) return;
    aliases.add(raw);
    const stripped = stripBattleImagineSkillPrefix(raw);
    if (stripped && stripped !== raw) aliases.add(stripped);
  };
  add(row.Name);
  add(row.NameDesign);
  add(row.DesignName);
  for (const value of Object.values(row.Names ?? {})) add(value);
  for (const value of Object.values(row.MonsterNames ?? {})) add(value);
  for (const value of Object.values(row.QuoteTexts ?? {})) add(value);
  return aliases;
}

function buildAoyiSkillOwnerRecords(aoyiSkills) {
  const rows = Array.isArray(aoyiSkills) ? aoyiSkills : Object.values(aoyiSkills ?? {});
  const ownerNamesBySkillAlias = new Map();
  for (const row of rows) {
    const ownerNames = normalizedNames(row.MonsterNames);
    if (!Object.keys(ownerNames).length) continue;
    for (const key of aoyiSkillNameKeys(row)) {
      if (!ownerNamesBySkillAlias.has(key)) ownerNamesBySkillAlias.set(key, ownerNames);
    }
  }

  const byNameKey = new Map();
  for (const row of rows) {
    const skillId = toNumber(row.Id ?? row.id);
    if (skillId === null) continue;
    const ownerNames = aoyiSkillOwnerNames(row, ownerNamesBySkillAlias);
    if (!ownerNames) continue;
    const aliases = aoyiSkillAliases(row);
    const record = {
      source: "skill_aoyi_icons",
      sourceId: skillId,
      priority: -2,
      ownerNames,
      aliases,
      matchAliases: [...aliases]
        .map((value) => normalizeOwnerSearchKey(stripBattleImagineSkillPrefix(value)))
        .filter((value) => value.length >= 2),
      monsterNames: normalizedNames(row.MonsterNames),
      skillEffectId: toNumber(row.SkillEffectId),
      sourceTable: row.Source,
      baseEffects: normalizeAoyiBaseEffect(row.BaseEffectValues),
      tierEffects: normalizeAoyiTierEffects(row.TierEffects),
    };
    const key = normalizeOwnerSearchKey(preferredName(ownerNames, row.Name ?? row.NameDesign));
    const existing = byNameKey.get(key);
    if (!existing) {
      byNameKey.set(key, record);
      continue;
    }
    const mergedAliases = new Set([...(existing.aliases ?? []), ...(record.aliases ?? [])]);
    const mergedMatchAliases = uniqueStrings([...(existing.matchAliases ?? []), ...(record.matchAliases ?? [])]);
    const keepRecord = (
      (record.skillEffectId && !existing.skillEffectId)
      || (record.sourceTable === "SkillAoyiTable" && existing.sourceTable !== "SkillAoyiTable")
    );
    const target = keepRecord ? record : existing;
    target.ownerNames = mergeNameMaps(target.ownerNames, keepRecord ? existing.ownerNames : record.ownerNames);
    target.aliases = mergedAliases;
    target.matchAliases = mergedMatchAliases;
    target.monsterNames = mergeNameMaps(target.monsterNames, keepRecord ? existing.monsterNames : record.monsterNames);
    target.skillEffectId ||= existing.skillEffectId || record.skillEffectId;
    target.baseEffects ||= existing.baseEffects || record.baseEffects;
    target.tierEffects = mergeAoyiTierEffects(existing.tierEffects, record.tierEffects);
    byNameKey.set(key, target);
  }
  return [...byNameKey.values()];
}

function normalizeAoyiEffectValues(values) {
  return (Array.isArray(values) ? values : [])
    .map((value) => {
      const rawValue = toNumber(value?.rawValue);
      const percentValue = toNumber(value?.percentValue);
      const decimalValue = toNumber(value?.decimalValue);
      if (rawValue === null || percentValue === null || decimalValue === null) return null;
      return stripUndefined({
        key: String(value?.key ?? "").trim(),
        scope: String(value?.scope ?? "").trim(),
        rawValue,
        percentValue,
        decimalValue,
        valueText: String(value?.valueText ?? `${percentValue}%`).trim(),
      });
    })
    .filter((value) => value?.key);
}

function normalizeAoyiBaseEffect(row) {
  if (!row || typeof row !== "object") return undefined;
  const values = normalizeAoyiEffectValues(row.values);
  if (values.length === 0) return undefined;
  return stripUndefined({
    values,
    sourceTable: row.sourceTable,
    sourceOffset: toNumber(row.sourceOffset),
    skillLevelId: toNumber(row.skillLevelId),
    skillEffectId: toNumber(row.skillEffectId),
    level: toNumber(row.level),
    cooldownSeconds: toNumber(row.cooldownSeconds),
  });
}

function normalizeAoyiTierEffects(rows) {
  return (Array.isArray(rows) ? rows : [])
    .map((row) => {
      const tier = toNumber(row?.tier);
      const values = normalizeAoyiEffectValues(row?.values);
      if (tier === null || values.length === 0) return null;
      return stripUndefined({
        tier,
        values,
        sourceTable: row?.sourceTable,
        sourceOffset: toNumber(row?.sourceOffset),
        rowId: toNumber(row?.rowId),
      });
    })
    .filter(Boolean)
    .sort((left, right) => left.tier - right.tier || Number(left.rowId ?? 0) - Number(right.rowId ?? 0));
}

function mergeAoyiTierEffects(left, right) {
  const byKey = new Map();
  for (const row of [...(left ?? []), ...(right ?? [])]) {
    if (!row) continue;
    byKey.set(`${row.tier}|${row.sourceOffset ?? ""}|${row.rowId ?? ""}`, row);
  }
  return [...byKey.values()].sort((a, b) =>
    a.tier - b.tier || Number(a.rowId ?? 0) - Number(b.rowId ?? 0),
  );
}

function itemOwnerNames(row) {
  const rawNames = normalizedNames(row.Names, row.NameDesign ?? row.Name);
  const names = {};
  for (const [locale, value] of Object.entries(rawNames)) {
    const stripped = stripBattleImaginePrefix(value);
    if ((stripped && stripped !== value) || /^Battle Imagine/i.test(String(value))) {
      names[locale] = stripped;
    }
  }
  return Object.keys(names).length ? names : null;
}

function monsterOwnerNames(row) {
  const rawNames = normalizedNames(row.Names, row.Name ?? row.NameDesign);
  const names = {};
  for (const [locale, value] of Object.entries(rawNames)) {
    const stripped = stripOwnerDecorations(value);
    if (stripped) names[locale] = stripped;
  }
  return Object.keys(names).length ? names : null;
}

function buildImagineOwnerIndex(items, monsters, aoyiSkills) {
  const index = {
    exact: new Map(),
    records: [],
    battleImagineRecords: 0,
    battleImagineSkillRecords: 0,
    monsterFallbackRecords: 0,
  };
  for (const record of buildAoyiSkillOwnerRecords(aoyiSkills)) {
    addOwnerRecord(index, record);
    index.battleImagineSkillRecords += 1;
  }
  for (const row of Array.isArray(items) ? items : Object.values(items ?? {})) {
    const iconPath = String(row.IconPath ?? "");
    const namesText = Object.values(row.Names ?? {}).join(" ");
    const isBattleImagine = iconPath.includes("skill_aoyi_product_icon")
      || BATTLE_IMAGINE_PREFIXES.some((pattern) => pattern.test(namesText) || pattern.test(String(row.NameDesign ?? "")));
    if (!isBattleImagine) continue;
    const ownerNames = itemOwnerNames(row);
    if (!ownerNames) continue;
    addOwnerRecord(index, {
      source: "itemnames",
      sourceId: row.Id,
      priority: 0,
      ownerNames,
      aliases: new Set(),
    });
    index.battleImagineRecords += 1;
  }

  for (const row of Object.values(monsters ?? {})) {
    const ownerNames = monsterOwnerNames(row);
    if (!ownerNames) continue;
    addOwnerRecord(index, {
      source: "monsternames",
      sourceId: row.Id,
      priority: 1,
      ownerNames,
      aliases: new Set(),
    });
    index.monsterFallbackRecords += 1;
  }

  return index;
}

function resolveAoyiSkillOwnerBySourceToken(ownerIndex, token) {
  if (!hasUsableSourceConfigOwnerToken(token)) return null;
  const matches = [];
  for (const record of ownerIndex.records) {
    if (record.source !== "skill_aoyi_icons") continue;
    for (const alias of record.matchAliases ?? []) {
      if (!alias || alias.length < 2) continue;
      if (alias.includes(token) || token.includes(alias)) {
        matches.push({ record, alias });
        break;
      }
    }
  }
  const unique = new Map(matches.map((match) => [String(match.record.sourceId), match]));
  if (unique.size !== 1) return null;
  const match = [...unique.values()][0];
  return {
    owner: {
      record: match.record,
      matchKind: "source-config-token",
    },
    ownerToken: localizedOwnerName(match.record, "zh-CN") || localizedOwnerName(match.record, "en"),
    suffix: "",
    matchKind: "source-config-token",
    matchedAlias: match.alias,
  };
}

function buildBattleImagineSourceConfigOwnerRules(buffRows, ownerIndex) {
  const rows = Array.isArray(buffRows) ? buffRows : Object.values(buffRows ?? {});
  const rules = new Map();
  for (const row of rows) {
    const buffId = toNumber(row.Id);
    if (buffId === null || !isBattleImagineRuntimeBuffId(buffId)) continue;
    if (hasPrimaryLocalizedName(row)) continue;
    const designName = buffRowBaseNames(row)?.design ?? row.DesignName ?? row.NameDesign ?? row.Name;
    const token = sourceConfigOwnerToken(designName);
    const parts = splitDesignNameParts(designName);
    const ownerMatch = resolveAoyiSkillOwnerBySourceToken(ownerIndex, token)
      ?? fallbackOwnerMatchFromDesignParts(parts);
    if (!ownerMatch) continue;
    rules.set(buffId, stripUndefined({
      sourceConfigId: buffId,
      sourceConfigDesignName: designName,
      sourceConfigOwnerToken: token,
      ownerSkillId: ownerMatch.owner.record.sourceId,
      ownerSkillEffectId: ownerMatch.owner.record.skillEffectId,
      ownerName: localizedOwnerName(ownerMatch.owner.record, "en"),
      ownerNames: ownerMatch.owner.record.ownerNames,
      ownerMonsterNames: ownerMatch.owner.record.monsterNames,
      ownerBaseEffects: ownerMatch.owner.record.baseEffects,
      ownerTierEffects: ownerMatch.owner.record.tierEffects,
      ownerMatch,
      matchedAlias: ownerMatch.matchedAlias,
    }));
  }
  const byOwnerSkillId = new Map();
  for (const rule of rules.values()) {
    const key = rule.ownerSkillId !== undefined ? String(rule.ownerSkillId) : "";
    if (!key) continue;
    if (!byOwnerSkillId.has(key)) byOwnerSkillId.set(key, []);
    byOwnerSkillId.get(key).push(rule);
  }
  rules.byOwnerSkillId = byOwnerSkillId;
  return rules;
}

function buffSourceNamesFromSourceConfigOwner(row, sourceConfigOwnerRules) {
  const buffId = toNumber(row.Id);
  if (buffId === null) return null;
  const rule = sourceConfigOwnerRules.get(buffId - 1);
  if (!rule?.ownerMatch) return null;
  const baseNames = buffRowBaseNames(row);
  return {
    names: ownerQualifiedNames(baseNames, {
      ...rule.ownerMatch,
      suffix: baseNames?.design,
    }),
    ownerMatch: rule.ownerMatch,
    sourceConfigRule: rule,
  };
}

function resolveOwnerRecord(index, token) {
  const key = normalizeOwnerKey(token);
  if (!key) return null;
  const exact = index.exact.get(key);
  if (exact?.length) {
    return { record: chooseOwnerRecord(exact), matchKind: "exact" };
  }

  const matches = [];
  for (const record of index.records) {
    for (const alias of record.aliases) {
      if (alias.length < 2) continue;
      if (alias.includes(key) || key.includes(alias)) {
        matches.push({ record, alias });
        break;
      }
    }
  }
  if (!matches.length) return null;
  matches.sort((left, right) =>
    left.record.priority - right.record.priority
    || left.alias.length - right.alias.length
    || String(left.record.sourceId ?? "").localeCompare(String(right.record.sourceId ?? ""))
  );
  return { record: matches[0].record, matchKind: "contains" };
}

function splitDelimitedOwner(value) {
  const text = String(value || "").trim();
  const parts = text.split(/\s*[-－—–]\s*/).map((part) => part.trim()).filter(Boolean);
  if (parts.length < 2) return null;
  return {
    ownerToken: parts[0],
    suffix: parts.slice(1).join(" - "),
    matchKind: "delimiter",
  };
}

function splitOwnerPrefix(value, ownerIndex) {
  const text = String(value || "").trim();
  const normalized = normalizeOwnerKey(text);
  if (!normalized) return null;
  const matches = [];
  for (const record of ownerIndex.records) {
    for (const alias of record.aliases) {
      if (alias.length < 2) continue;
      if (normalized.startsWith(alias)) {
        const visibleAlias = Object.values(record.ownerNames ?? {})
          .find((name) => normalizeOwnerKey(name) === alias);
        matches.push({ record, alias, visibleAlias });
        break;
      }
    }
  }
  if (!matches.length) return null;
  matches.sort((left, right) =>
    right.alias.length - left.alias.length
    || left.record.priority - right.record.priority
    || String(left.record.sourceId ?? "").localeCompare(String(right.record.sourceId ?? ""))
  );
  const match = matches[0];
  const ownerToken = match.visibleAlias ?? localizedOwnerName(match.record, "zh-CN");
  const suffix = ownerToken && text.startsWith(ownerToken)
    ? text.slice(ownerToken.length).trim()
    : text;
  return {
    ownerToken,
    suffix,
    matchKind: "prefix",
    owner: { record: match.record, matchKind: "prefix" },
  };
}

function splitOwnerFromDesign(value, ownerIndex) {
  const delimited = splitDelimitedOwner(value);
  if (delimited) {
    const owner = resolveOwnerRecord(ownerIndex, delimited.ownerToken);
    if (owner) return { ...delimited, owner };
  }
  const prefixed = splitOwnerPrefix(value, ownerIndex);
  if (prefixed) return prefixed;
  return null;
}

function isImagineBuffDetail(detail) {
  return [
    detail.Category,
    detail.SourceKind,
    detail.SourceType,
    detail.SourceRole,
    detail.CategoryLabel,
    detail.Badge,
    detail.Reason,
    detail.ParentRecountName,
  ].some((value) => /imagine|arcane/i.test(String(value ?? "")));
}

function shouldPrefixName(baseName, ownerName) {
  const baseKey = normalizeOwnerKey(baseName);
  const ownerKey = normalizeOwnerKey(ownerName);
  return Boolean(baseKey && ownerKey && !baseKey.includes(ownerKey));
}

function ownerQualifiedNames(baseNames, ownerMatch) {
  if (!ownerMatch?.owner?.record) return baseNames;
  const ownerNames = ownerMatch.owner.record.ownerNames;
  const out = {};
  for (const locale of LOCALES) {
    const baseName = baseNames?.[locale];
    if (!baseName) continue;
    const ownerName = localizedOwnerName(ownerMatch.owner.record, locale);
    out[locale] = shouldPrefixName(baseName, ownerName)
      ? `${ownerName} - ${baseName}`
      : baseName;
  }

  const designSuffix = ownerMatch.suffix || baseNames?.design;
  const designOwner = ownerMatch.ownerToken || localizedOwnerName(ownerMatch.owner.record, "zh-CN");
  if (designOwner && designSuffix) {
    out.design = `${designOwner} - ${designSuffix}`;
  } else if (baseNames?.design) {
    out.design = baseNames.design;
  }

  if (!Object.keys(out).length) return baseNames;
  return mergeNameMaps(out, baseNames);
}

function buffSourceNamesFromDetail(detail, buffSourceId, ownerIndex) {
  const baseNames = normalizedNames(
    detail.LinkedNames ?? detail.DisplayNames ?? detail.DamageNames,
    detail.LinkedName ?? detail.DisplayName ?? detail.DamageName ?? `Buff ${buffSourceId}`,
  );
  if (!isImagineBuffDetail(detail)) return baseNames;
  const designText = baseNames.design ?? detail.LinkedNames?.design ?? detail.DisplayNames?.design ?? detail.DamageNames?.design;
  const ownerMatch = splitOwnerFromDesign(designText, ownerIndex)
    ?? fallbackOwnerMatchFromDesignParts(splitDesignNameParts(designText));
  return ownerQualifiedNames(baseNames, ownerMatch);
}

function buffSourceNamesFromBuffRow(row, ownerIndex) {
  const buffId = toNumber(row.Id);
  if (buffId === null) return null;
  const baseNames = normalizedNames(row.Names, row.Name ?? row.NameDesign ?? row.DesignName ?? `Buff ${buffId}`);
  const designText = baseNames.design ?? row.DesignName ?? row.NameDesign;
  const ownerMatch = splitOwnerFromDesign(designText, ownerIndex)
    ?? fallbackOwnerMatchFromDesignParts(splitDesignNameParts(designText));
  if (!ownerMatch) return null;
  return {
    names: ownerQualifiedNames(baseNames, ownerMatch),
    ownerMatch,
  };
}

function buffRowBaseNames(row) {
  const buffId = toNumber(row.Id);
  return normalizedNames(row.Names, row.Name ?? row.NameDesign ?? row.DesignName ?? `Buff ${buffId ?? ""}`);
}

function rowText(row) {
  return [
    row.Name,
    row.NameDesign,
    row.DesignName,
    row.IconPath,
    ...Object.values(row.Names ?? {}),
  ].filter(Boolean).join(" ");
}

function hasPrimaryLocalizedName(row) {
  const names = buffRowBaseNames(row);
  return LOCALES.some((locale) => Boolean(names?.[locale]));
}

function isBattleImagineRuntimeBuffId(buffId) {
  return buffId >= 2110000 && buffId < 2111000;
}

function isLikelyImagineRuntimeBuffRow(row, qualified) {
  const buffId = toNumber(row.Id);
  if (buffId === null) return false;
  if (qualified?.ownerMatch?.owner?.record?.source === "itemnames") {
    if (isBattleImagineRuntimeBuffId(buffId)) return true;
    return qualified.ownerMatch.owner.matchKind !== "contains" && hasPrimaryLocalizedName(row);
  }
  if (!isBattleImagineRuntimeBuffId(buffId)) return false;
  if (!hasPrimaryLocalizedName(row)) return false;
  const text = rowText(row);
  if (/\b(debug|test|dummy|placeholder|ui only)\b/i.test(text)) return false;
  if (/表现|材质|出生|隐藏|逻辑|测试|占位/.test(text)) return false;
  const iconPath = String(row.IconPath ?? "");
  return /\/(?:buff|debuff)\//i.test(iconPath)
    || /(?:buff|debuff)_/i.test(iconPath)
    || /主动|效果|自身|加|提升|降低|下降|重伤|禁止|凝滞|Specialization|Enhancement|Blood|Shield|Command|Roar|Luck|Frostforce|Stasis|Haste|Mastery|Versatility|Crit|Lucky|Surge|Enchantment/i.test(text);
}

function imagineRuntimeSourceType(row) {
  const text = rowText(row);
  const iconPath = String(row.IconPath ?? "");
  if (isIcdLockoutNameText(text) || /凝滞|内置冷却|冷却限制/.test(text)) {
    return "imagine-icd";
  }
  if (/\/debuff\//i.test(iconPath) || /debuff_/i.test(iconPath)) {
    return "imagine-debuff";
  }
  return "imagine-buff";
}

const DESIGN_OWNER_EN_FALLBACKS = new Map([
  ["\u5F13", "Bow"],
  ["\u7F57\u7F57\u62C9", "Rorola"],
  ["\u9AD8\u539F\u8725\u8734\u738B", "Highland Lizard King"],
]);

const DESIGN_SUFFIX_EN_FALLBACKS = new Map([
  ["\u73A9\u5BB6\u8EAB\u4E0A\u76D1\u63A7", "Player Monitor"],
  ["\u4E3B\u52A8\u8BB0\u65F6", "Active Timer"],
  ["\u4E3B\u52A8\u8BA1\u65F6", "Active Timer"],
  ["\u56DE\u80FD\u5929\u751FBUFF", "Energy Recovery Passive"],
  ["\u6682\u505C\u5149\u80FD\u6D88\u8017", "Photon Energy Cost Pause"],
]);

function normalizedDesignToken(value) {
  return String(value ?? "").replace(/\s+/g, "").trim();
}

function englishDesignOwnerFallback(ownerToken, ownerMatch) {
  const normalized = normalizedDesignToken(ownerToken);
  const mapped = DESIGN_OWNER_EN_FALLBACKS.get(normalized);
  if (mapped) return mapped;
  if (ownerMatch?.owner?.record && ownerMatch.owner.matchKind !== "contains") {
    const ownerName = localizedOwnerName(ownerMatch.owner.record, "en");
    if (ownerName) return ownerName;
  }
  return /^[\x20-\x7e]+$/.test(String(ownerToken ?? "")) ? String(ownerToken).trim() : null;
}

function englishDesignSuffixFallback(suffix) {
  const normalized = normalizedDesignToken(suffix);
  const mapped = DESIGN_SUFFIX_EN_FALLBACKS.get(normalized);
  if (mapped) return mapped;
  return /^[\x20-\x7e]+$/.test(String(suffix ?? "")) ? String(suffix).trim() : null;
}

function splitDesignNameParts(designName) {
  const parts = String(designName ?? "")
    .split(/\s*[-\uFF0D\u2013\u2014]\s*/)
    .map((part) => part.trim())
    .filter(Boolean);
  if (parts.length < 2) return null;
  return {
    ownerToken: parts[0],
    suffix: parts.slice(1).join(" - "),
  };
}

function fallbackOwnerMatchFromDesignParts(parts, resolvedOwnerMatch = null) {
  if (!parts?.ownerToken) return null;
  const ownerName = englishDesignOwnerFallback(parts.ownerToken, resolvedOwnerMatch);
  if (!ownerName) return null;
  const ownerNames = {
    en: ownerName,
    "zh-CN": parts.ownerToken,
    "zh-TW": parts.ownerToken,
    design: parts.ownerToken,
  };
  return {
    ownerToken: parts.ownerToken,
    suffix: parts.suffix ?? "",
    matchKind: "design-owner-fallback",
    matchedAlias: parts.ownerToken,
    owner: {
      record: {
        source: "design-owner-fallback",
        sourceId: `design-owner:${normalizedDesignToken(parts.ownerToken)}`,
        priority: 50,
        ownerNames,
      },
      matchKind: "design-owner-fallback",
    },
  };
}

function designOnlyRuntimeBuffNames(row, ownerIndex) {
  const baseNames = buffRowBaseNames(row);
  const designName = baseNames.design ?? row.DesignName ?? row.NameDesign;
  const parts = splitDesignNameParts(designName);
  if (!parts) return null;
  const ownerMatch = splitOwnerFromDesign(designName, ownerIndex)
    ?? fallbackOwnerMatchFromDesignParts(parts);
  const ownerName = englishDesignOwnerFallback(parts.ownerToken, ownerMatch);
  const suffixName = englishDesignSuffixFallback(parts.suffix);
  if (!ownerName || !suffixName) return null;
  const names = mergeNameMaps(baseNames, {
    en: `${ownerName} - ${suffixName}`,
    design: `${parts.ownerToken} - ${parts.suffix}`,
  });
  return { names, ownerMatch };
}

function designOnlyRuntimeSourceType(row) {
  const text = rowText(row);
  if (/debuff|Debuff|\u6613\u4F24|\u964D\u4F4E|\u4E0B\u964D|\u7981\u6B62|\u51CF/i.test(text)) return "runtime-debuff";
  return "runtime-buff";
}

function findUniqueRecountNameMatch(row, recountNameIndex) {
  const names = buffRowBaseNames(row);
  const matches = new Map();
  for (const [locale, name] of Object.entries(names ?? {})) {
    if (locale === "design") continue;
    const normalized = normalizeLabel(name);
    if (!normalized) continue;
    const rows = recountNameIndex.get(`${locale}|${normalized}`) ?? [];
    for (const recountRow of rows) {
      matches.set(String(recountRow.recountId), recountRow);
    }
  }
  if (matches.size !== 1) return null;
  return [...matches.values()][0];
}

class EffectSourceBuilder {
  constructor(recountRows) {
    this.effectSourcesById = {};
    this.buffIdToEffectSourceIds = {};
    this.damageIdToEffectSourceIds = {};
    this.recountIdToEffectSourceIds = {};
    this.recountRows = recountRows;
    this.recountNameIndex = buildRecountNameIndex(recountRows);
  }

  upsertSource(source) {
    const sourceId = source.sourceId;
    const existing = this.effectSourcesById[sourceId] ?? {
      sourceId,
      sourceKind: source.sourceKind,
      sourceType: source.sourceType,
      sourceName: source.sourceName,
      sourceNames: source.sourceNames,
      iconPath: source.iconPath,
      runtimeDetection: source.runtimeDetection,
      sourceTable: source.sourceTable,
      sourceEntityId: source.sourceEntityId,
      familyId: source.familyId,
      classGateIds: source.classGateIds,
      buffIds: [],
      descriptions: source.descriptions,
      cleanDescriptions: source.cleanDescriptions,
      modifierEvidence: source.modifierEvidence,
      effectComponents: source.effectComponents,
      targets: [],
      evidence: [],
    };

    existing.buffIds = uniqueNumbers([...(existing.buffIds ?? []), ...(source.buffIds ?? [])]);
    existing.classGateIds = uniqueNumbers([
      ...(existing.classGateIds ?? []),
      ...(source.classGateIds ?? []),
    ]);
    existing.targets = mergeTargets(existing.targets, source.targets ?? []);
    existing.evidence = mergeEvidence(existing.evidence, source.evidence ?? []);
    existing.effectComponents = mergeEffectComponents(existing.effectComponents, source.effectComponents ?? []);
    existing.modifierEvidence = existing.modifierEvidence ?? source.modifierEvidence;
    existing.sourceNames = mergeNameMaps(existing.sourceNames, source.sourceNames);
    existing.descriptions = mergeDescriptionMaps(existing.descriptions, source.descriptions);
    existing.cleanDescriptions = mergeDescriptionMaps(existing.cleanDescriptions, source.cleanDescriptions);
    if ((!existing.sourceName || /^Buff \d+$/i.test(existing.sourceName)) && source.sourceName) {
      existing.sourceName = source.sourceName;
    }
    existing.iconPath ||= source.iconPath;
    existing.sourceTable ||= source.sourceTable;
    existing.runtimeDetection ||= source.runtimeDetection;

    this.effectSourcesById[sourceId] = stripUndefined(existing);

    for (const buffId of existing.buffIds ?? []) {
      addIndex(this.buffIdToEffectSourceIds, buffId, sourceId);
    }
    for (const target of source.targets ?? []) {
      if (target.targetKind === "damage" && target.damageId) {
        addIndex(this.damageIdToEffectSourceIds, target.damageId, sourceId);
      } else if (target.targetKind === "recount" && target.recountId) {
        addIndex(this.recountIdToEffectSourceIds, target.recountId, sourceId);
      }
    }
  }

  addDescriptionTargetSources(sourceFactory, rows) {
    for (const row of rows) {
      const source = sourceFactory(row);
      if (!source) continue;
      const targets = matchDescriptionTargets(row.cleanDescriptions, this.recountNameIndex, this.recountRows)
        .map((target) => ({
          targetKind: "recount",
          recountId: target.recountId,
          recountName: target.recountName,
          relationshipKind: "affected-dream-damage-target",
          evidenceSource: "EffectSources.DescriptionTextDreamDmgTarget",
          evidenceStatus: target.evidenceStatus,
          sourceTable: row.descriptionSourceTable,
          descriptionId: row.descriptionId,
          localeId: target.localeId,
          targetText: target.targetText,
          candidateText: target.candidateText,
          matchedText: target.matchedText,
        }));
      this.upsertSource({ ...source, targets });
    }
  }
}

function mergeTargets(left, right) {
  const byKey = new Map();
  for (const target of [...(left ?? []), ...(right ?? [])]) {
    const key = [
      target.targetKind,
      target.damageId ?? target.recountId ?? "",
      target.relationshipKind ?? "",
      target.evidenceSource ?? "",
      target.evidenceStatus ?? "",
    ].join("|");
    byKey.set(key, stripUndefined(target));
  }
  return [...byKey.values()].sort((a, b) =>
    String(a.targetKind).localeCompare(String(b.targetKind))
      || Number(a.damageId ?? a.recountId ?? 0) - Number(b.damageId ?? b.recountId ?? 0),
  );
}

function mergeEvidence(left, right) {
  const byKey = new Map();
  for (const evidence of [...(left ?? []), ...(right ?? [])]) {
    const key = JSON.stringify(evidence);
    byKey.set(key, stripUndefined(evidence));
  }
  return [...byKey.values()];
}

function mergeEffectComponents(left, right) {
  const byKey = new Map();
  for (const component of [...(left ?? []), ...(right ?? [])]) {
    if (!component) continue;
    const key = component.componentKey
      ?? component.label
      ?? JSON.stringify(component);
    byKey.set(String(key), stripUndefined(component));
  }
  return [...byKey.values()].sort((a, b) =>
    Number(a.componentOrder ?? 999) - Number(b.componentOrder ?? 999)
      || String(a.componentKey ?? "").localeCompare(String(b.componentKey ?? "")),
  );
}

function mergeRuntimeDetection(left, right) {
  const parts = [];
  for (const value of [left, right]) {
    for (const part of String(value ?? "").split("-or-")) {
      const text = part.trim();
      if (text && !parts.includes(text)) parts.push(text);
    }
  }
  return parts.length ? parts.join("-or-") : undefined;
}

function isProducedRelationshipKind(relationshipKind) {
  const value = String(relationshipKind ?? "");
  return value.startsWith("produces-")
    || value === "buff-source-damage-row"
    || value === "buff-source-recount-row"
    || value === "direct-linked-factor-damage-row";
}

function sourceHasProducedDamageTargets(source) {
  return (source.targets ?? []).some((target) =>
    isProducedRelationshipKind(target.relationshipKind)
    && (target.targetKind === "damage" || target.targetKind === "recount")
  );
}

function sourceHasModifierTargets(source) {
  return (source.targets ?? []).some((target) => !isProducedRelationshipKind(target.relationshipKind));
}

function sourceRelationshipKinds(source) {
  return uniqueStrings((source.targets ?? []).map((target) => target.relationshipKind).filter(Boolean));
}

function sourceHasActivationAliasEvidence(source) {
  return (source.evidence ?? []).some((evidence) =>
    String(evidence?.source ?? "").includes("activation")
    || String(evidence?.relationshipPolicy ?? "").includes("activation window")
  );
}

function attributionPredicateTags(component) {
  const tags = new Set(component.predicateTags ?? []);
  if (component.targetPredicate?.monsterRankAtLeast) tags.add("target.elite-or-stronger");
  if (component.attackerPredicate?.monsterRankAtLeast) tags.add("attacker.elite-or-stronger");
  if (component.sourcePredicate?.actorKind) tags.add(`source.${component.sourcePredicate.actorKind}`);
  if (component.activationPredicate?.kind) tags.add(`activation.${component.activationPredicate.kind}`);
  if (component.direction) tags.add(`direction.${component.direction}`);
  return [...tags].sort((left, right) => left.localeCompare(right));
}

function componentFormulaInfo(component) {
  const info = FORMULA_COMPONENT_CLASS[component.effectClass] ?? {};
  const predicateEvidence = [];
  const predicateTags = attributionPredicateTags(component);
  if (predicateTags.includes("target.elite-or-stronger")) {
    predicateEvidence.push("target predicate evaluation, such as elite-or-stronger");
  }
  if (predicateTags.some((tag) => tag.startsWith("source.companion") || tag.startsWith("source.summon"))) {
    predicateEvidence.push("source predicate evaluation, such as companion or summon");
  }
  if (predicateTags.some((tag) => tag.startsWith("activation."))) {
    predicateEvidence.push("modifier windows");
  }
  if (component.contributionScope === "targeted") {
    predicateEvidence.push("target uid");
  }
  return {
    formulaTermIds: uniqueStrings([...(component.formulaTermIds ?? []), ...(info.formulaTermIds ?? [])]),
    contributionGroups: uniqueStrings([...(component.contributionGroups ?? []), ...(info.contributionGroups ?? [])]),
    requiredRuntimeEvidence: uniqueStrings([
      ...(component.requiredRuntimeEvidence ?? []),
      ...(info.requiredRuntimeEvidence ?? []),
      ...predicateEvidence,
    ]),
    predicateTags,
  };
}

function englishEvidenceText(source) {
  return cleanMarkup([
    preferredText(source.cleanDescriptions),
    preferredText(source.descriptions),
    source.modifierEvidence?.cleanDescription,
    source.modifierEvidence?.resolvedDescription,
    source.sourceName,
    preferredName(source.sourceNames),
  ].filter(Boolean).join(" "));
}

function allEvidenceText(source) {
  return cleanMarkup([
    ...Object.values(source.cleanDescriptions ?? {}),
    ...Object.values(source.descriptions ?? {}),
    source.modifierEvidence?.cleanDescription,
    source.modifierEvidence?.resolvedDescription,
    source.sourceName,
    ...Object.values(source.sourceNames ?? {}),
  ].filter(Boolean).join(" "));
}

function modifierEvidenceGradeDescriptions(source) {
  const rows = Array.isArray(source.modifierEvidence?.gradeRows)
    ? source.modifierEvidence.gradeRows
    : [];
  return uniqueStrings(rows.map((row) => cleanMarkup(
    row.cleanResolvedDescription
      || row.resolvedDescription
      || preferredText(row.cleanResolvedDescriptions)
      || preferredText(row.resolvedDescriptions)
      || "",
  )).filter(Boolean));
}

function sourceHasIcdLockoutDescription(source) {
  return hasIcdLockoutDescription(allEvidenceText(source));
}

function sourceIcdLockoutSeconds(source) {
  const text = allEvidenceText(source);
  return extractIcdLockoutSeconds(text);
}

function inferredComponent(key, label, effectClass, order, extra = {}) {
  return stripUndefined({
    componentKey: key,
    componentOrder: order,
    label,
    effectClass,
    contributionScope: extra.contributionScope ?? "global",
    direction: extra.direction,
    stat: extra.stat,
    valueScope: extra.valueScope,
    formulaTermIds: extra.formulaTermIds,
    contributionGroups: extra.contributionGroups,
    valueTexts: extra.valueTexts,
    baseValues: extra.baseValues,
    valueTiers: extra.valueTiers,
    predicateTags: extra.predicateTags,
    targetPredicate: extra.targetPredicate,
    attackerPredicate: extra.attackerPredicate,
    sourcePredicate: extra.sourcePredicate,
    activationPredicate: extra.activationPredicate,
    requiredRuntimeEvidence: extra.requiredRuntimeEvidence,
    valueTextSource: extra.valueTextSource,
    inferenceSource: "EffectSources.formulaAttributionText",
  });
}

const CRITICAL_DAMAGE_TEXT = /\bcrit(?:ical)?\s*dmg\b|\bcritical damage\b/i;
const CRITICAL_RATE_TEXT = /\bcrit(?:ical)?\s*(?:rate|chance)\b|\b(?:rate|chance)\s+to\s+crit(?:ical)?\b/i;
const PRIMARY_STAT_CONVERSION_TEXT = /\b(?:(?:adaptive\s*)?(?:strength|str|intellect|int|agility|agi|main\s*(?:stat|stats|attribute|attributes)|primary\s*(?:stat|stats|attribute|attributes))\s*(?:\/\s*(?:strength|str|intellect|int|agility|agi))*\s*(?:\+|increase(?:s|d)?(?:\s+by)?|boost(?:s|ed)?(?:\s+by)?|bonus\s*:?)\s*[+-]?\d|(?:increase(?:s|d)?|boosts?|adds?)\s+(?:adaptive\s*)?(?:strength|str|intellect|int|agility|agi|main\s*(?:stat|stats|attribute|attributes)|primary\s*(?:stat|stats|attribute|attributes))(?:\/(?:strength|str|intellect|int|agility|agi))*\s*(?:by\s*)?[+-]?\d)\b/i;
const FINAL_DAMAGE_TEXT = /\bfinal\s+(?:dmg|damage|damage bonus|damage increase)\b/i;
const PHYSICAL_MAGIC_DAMAGE_TEXT = /\b(?:(?:physical|magic|magical)(?!\s+attack\b)\s*(?:\/\s*(?:physical|magic|magical))?\s*(?:(?:dmg|damage)\s*)?(?:enhancement|increase|boost|bonus|strength|value|percentage)|(?:enhancement|increase|boost|bonus|strength|value|percentage)\s*(?:to|for|of)?\s*(?:physical|magic|magical)(?:\s*(?:dmg|damage))?)\b/i;
const SEASON_DAMAGE_TEXT = /\b(?:(?:season(?:al)?|dream(?:scape)?|breakthrough).{0,40}(?:dmg|damage|damage bonus|damage increase)|(?:dmg|damage|damage bonus|damage increase).{0,40}(?:season(?:al)?|dream(?:scape)?|breakthrough))\b/i;
const SEASON_SUPPRESSION_TEXT = /\bseason(?:al)?\s+(?:strength\s+)?suppression\b|\bseason(?:al)?\s+suppression\b/i;
const PARTY_SCOPE_TEXT = /\b(?:allies?|ally|party(?:\s+members?)?|team(?:mates?|\s+members?)|other players)\b/i;
const SELF_SCOPE_TEXT = /\b(?:self|own|your|you)\b/i;
const PRODUCED_DAMAGE_CLAUSE_TEXT = /\b(?:deals?|dealing|dealt|inflicts?|inflicting|causes?|creates?|summons?|fires?|launches?)\b.{0,140}\b(?:dmg|damage)\b|\b(?:dmg|damage)\b.{0,140}\b(?:equal to|based on|of\s+(?:the\s+)?(?:caster'?s?|your|own)?\s*(?:atk|matk|attack|magic attack|armor|defen[cs]e))/i;
const LOOSE_PERCENT_ATK_DAMAGE_PATTERN = /(?:p\.?dmg|m\.?dmg|dmg|damage)[^。；;,\n]{0,80}?[+-]?\d+(?:[.,]\d+)?\s*%[^。；;,\n]{0,80}?(?:atk|attack|attack power)|[+-]?\d+(?:[.,]\d+)?\s*%[^。；;,\n]{0,80}?(?:atk|attack|attack power)[^。；;,\n]{0,80}?(?:damage|dmg|p\.?dmg|m\.?dmg)/i;
const ATTACK_SCALED_SKILL_DAMAGE_PATTERN = /\b(?:(?:deals?|dealing|inflicts?|inflicting)\s+)?(?:physical|magic|elemental|fire|flame|ice|frost|thunder|lightning|wind|light|dark|rock)?\s*(?:damage|dmg)\s*(?:equal\s*to|of)\s*[+-]?\d+(?:[.,]\d+)?\s*%\s*(?:of\s*)?(?:atk|attack|attack power)\b/i;
const MODIFIER_INTENT_TEXT = /\b(?:increase|increases|increased|boost|boosts|bonus|grant|grants|gains?|adds?|raises?|reduces?|reduced|decreases?|decreased|converted|conversion)\b|[+-]\s*\d/i;
const TRIGGER_CONDITION_TEXT = /\b(?:when|if|after|upon|every)\b.{0,120}\b(?:deal|deals|dealing|dealt|hit|hits|land|lands|trigger|triggers|inflict|inflicts|stack|stacks|gained)\b/i;

function splitEffectClauses(text) {
  return String(text || "")
    .split(/(?:[.!?;。；]|<br\s*\/?>|,\s*but\s+|\s+but\s+|，但是|，但)+/i)
    .map((clause) => clause.trim())
    .filter(Boolean);
}

function valueTextLooksDistance(rawText, sourceText = "", index = -1) {
  const raw = String(rawText || "");
  if (/\d\s*(?:m|meter|meters|metre|metres)\b/i.test(raw)) return true;
  if (index < 0 || /[%s]\b/i.test(raw)) return false;
  const end = index + raw.length;
  return /^\s*(?:m|meter|meters|metre|metres)\b/i.test(String(sourceText || "").slice(end, end + 12));
}

function extractFormulaValueTexts(value) {
  const text = String(value || "");
  const seen = new Set();
  const out = [];
  const pattern = /[+-]?\d+(?:[.,]\d+)?\s*(?:%|s|sec|secs|second|seconds|m|meter|meters|metre|metres)?/gi;
  for (const match of text.matchAll(pattern)) {
    const raw = String(match[0] || "").trim().replace(/\s+/g, " ");
    if (!raw || valueTextLooksDistance(raw, text, match.index ?? -1)) continue;
    if (seen.has(raw)) continue;
    seen.add(raw);
    out.push(raw);
  }
  return out;
}

function uniqueValueTextsFromClauses(clauses) {
  return uniqueStrings(clauses.flatMap((clause) => extractFormulaValueTexts(clause)));
}

const FORMULA_EFFECT_CLAUSE_SEPARATOR = /(?:[!?;\u3002\uff1b]|(?<!\d)\.(?!\d)|<br\s*\/?>|,\s*but\s+|\s+but\s+|\uff0c\u4f46\u662f|\uff0c\u4f46)+/i;

function splitFormulaEffectClauses(text) {
  return String(text || "")
    .split(FORMULA_EFFECT_CLAUSE_SEPARATOR)
    .map((clause) => clause.trim())
    .filter(Boolean);
}

function clauseLooksLikeSkillCoefficient(clause) {
  const text = String(clause || "");
  return clauseIsProducedDamageFormula(text)
    || LOOSE_PERCENT_ATK_DAMAGE_PATTERN.test(text)
    || ATTACK_SCALED_SKILL_DAMAGE_PATTERN.test(text);
}

function clauseIsHealingOrLifesteal(clause) {
  return /\b(lifesteal|life steal|healing|heals?|hp recovery|recover(?:s|ed)? hp|restore(?:s|d)? hp)\b/i.test(String(clause || ""));
}

function componentClauseMatches(componentKey, effectClass, clause) {
  const key = String(componentKey || "");
  if (key === "critical-damage") return CRITICAL_DAMAGE_TEXT.test(clause);
  if (key === "critical-rate") return CRITICAL_RATE_TEXT.test(clause) || clauseIsCriticalRate(clause) || clauseHasCriticalRateAndDamage(clause);
  if (key === "atk") return !clauseLooksLikeSkillCoefficient(clause) && hasAttackStatText(clause);
  if (key === "matk") return !clauseLooksLikeSkillCoefficient(clause) && /\bmatk\b|\bmagic attack\b/i.test(clause);
  if (key === "physical-magic-enhancement") return !clauseLooksLikeSkillCoefficient(clause) && PHYSICAL_MAGIC_DAMAGE_TEXT.test(clause);
  if (key === "final-damage") return FINAL_DAMAGE_TEXT.test(clause);
  if (key === "season-damage" || key === "seasonal-factor-damage") return SEASON_DAMAGE_TEXT.test(clause);
  if (key === "season-suppression") return SEASON_SUPPRESSION_TEXT.test(clause);
  if (key === "elemental-damage") {
    return /\b(light|fire|ice|thunder|dark|elemental)\b.*\b(dmg|damage|strength)\b|\b(dmg|damage)\b.*\b(light|fire|ice|thunder|dark|elemental)\b/i.test(clause);
  }
  if (key === "generic-damage" || effectClass === "damage-modifier") {
    return !clauseLooksLikeSkillCoefficient(clause)
      && !clauseIsHealingOrLifesteal(clause)
      && /\b(more dmg|more damage|damage dealt|dmg dealt|skill damage|dmg to|damage to|boosting .*damage|increases? .*dmg|increases? .*damage|deal .*more dmg|deal .*more damage)\b/i.test(clause);
  }
  if (key === "haste-or-attack-speed") return /\bhaste\b|\battack\s*spd\b|\battack speed\b|\banimation speed\b/i.test(clause);
  if (key === "cooldown-or-resource") return /\bcd\b|\bcooldown\b|\bresource\b|\benergy\b/i.test(clause);
  if (key === "adaptive-primary-stat" || effectClass === "stat-conversion") {
    return PRIMARY_STAT_CONVERSION_TEXT.test(clause) && clauseEligibleForFormulaStat(clause);
  }
  return false;
}

function componentValueTextsFromDescription(text, componentKey, effectClass) {
  const clauses = splitFormulaEffectClauses(text).filter((clause) =>
    componentClauseMatches(componentKey, effectClass, clause)
  );
  return uniqueValueTextsFromClauses(clauses);
}

function modifierEvidenceGradeValueTexts(source, componentKey, effectClass) {
  const rows = Array.isArray(source.modifierEvidence?.gradeRows)
    ? source.modifierEvidence.gradeRows
    : [];
  if (!rows.length) return [];

  return uniqueStrings(rows.flatMap((row) => {
    const text = row.cleanResolvedDescription
      || row.resolvedDescription
      || preferredText(row.cleanResolvedDescriptions)
      || preferredText(row.resolvedDescriptions)
      || "";
    return componentValueTextsFromDescription(text, componentKey, effectClass);
  }));
}

function clauseIsCriticalRate(clause) {
  return /\bcrit(?:ical)?\b/i.test(clause) && !CRITICAL_DAMAGE_TEXT.test(clause);
}

function clauseHasCriticalRateAndDamage(clause) {
  const value = String(clause || "");
  return (
    /\bcrit(?:ical)?\b\s*(?:and|&|\/|\+|,)\s*(?:crit(?:ical)?\s*dmg|critical damage)\b/i.test(value)
    || /\b(?:crit(?:ical)?\s*dmg|critical damage)\b\s*(?:and|&|\/|\+|,)\s*crit(?:ical)?\b/i.test(value)
  );
}

function clauseIsProducedDamageFormula(clause) {
  return PRODUCED_DAMAGE_CLAUSE_TEXT.test(String(clause || ""));
}

function clauseHasModifierIntent(clause) {
  return MODIFIER_INTENT_TEXT.test(String(clause || ""));
}

function clauseIsTriggerConditionOnly(clause) {
  const value = String(clause || "");
  return TRIGGER_CONDITION_TEXT.test(value) && !clauseHasModifierIntent(value);
}

function clauseEligibleForFormulaStat(clause) {
  return !clauseIsProducedDamageFormula(clause) && !clauseIsTriggerConditionOnly(clause);
}

function valueScopeForClauses(componentClauses, allClauses) {
  if (componentClauses.some((clause) => PARTY_SCOPE_TEXT.test(clause))) return "party";
  if (componentClauses.some((clause) => SELF_SCOPE_TEXT.test(clause))) return "owner";
  if (allClauses.some((clause) => PARTY_SCOPE_TEXT.test(clause))) return "owner";
  return undefined;
}

function isSeasonalPhantomFactorSource(source) {
  return String(source.sourceKind || "").toLowerCase() === "phantom-factor"
    || String(source.sourceType || "").toLowerCase() === "season-phantom-factor";
}

function inferEffectComponentsFromSource(source) {
  const text = englishEvidenceText(source);
  const gradeEvidenceText = modifierEvidenceGradeDescriptions(source).join("; ");
  const statConversionText = cleanMarkup([text, gradeEvidenceText].filter(Boolean).join("; "));
  const normalized = normalizeActivationText(text);
  const components = [];
  let order = 1;
  const valueTexts = extractFormulaValueTexts(text);
  const effectClauses = splitFormulaEffectClauses(text);
  const statConversionClauses = splitFormulaEffectClauses(statConversionText);
  const statConversionValueTexts = extractFormulaValueTexts(statConversionText);
  const targetArmorMitigationText =
    /\b(?:armor|defen[cs]e)\s*(?:break|down|reduction|reduced|reduce|decrease|decreased|decreases|shatter|shattered|lower|lowers|lowered|-\s*\d)/i.test(text)
    || /\b(?:break|reduce|reduces|reduced|decrease|decreases|decreased|shatter|shattered|lower|lowers|lowered)\b.{0,50}\b(?:target'?s?\s*)?(?:armor|defen[cs]e)\b/i.test(text)
    || /\b(?:shattered armor|armor break|armor down|defen[cs]e break|defen[cs]e down)\b/i.test(text)
    || /破甲|碎甲|护甲降低|降低.{0,12}护甲|防御降低|降低.{0,12}防御/.test(text);
  const targetResistanceMitigationText =
    /\b(?:resistance|resist)\s*(?:break|down|reduction|reduced|reduce|decrease|decreased|decreases|lower|lowers|lowered|-\s*\d)/i.test(text)
    || /\b(?:break|reduce|reduces|reduced|decrease|decreases|decreased|lower|lowers|lowered)\b.{0,50}\b(?:target'?s?\s*)?(?:resistance|resist)\b/i.test(text)
    || /\b(?:resistance break|resistance down|resist break|resist down)\b/i.test(text)
    || /抗性降低|降低.{0,12}抗性/.test(text);
  const armorScalingDamageText =
    /\b(?:percentage|%)\s+of\s+(?:your\s+)?(?:armor|defen[cs]e)\b/i.test(text)
    || /\b(?:based on|scales? with|equal to)\b.{0,50}\b(?:your\s+)?(?:armor|defen[cs]e)\b/i.test(text);
  const superArmorDamageText =
    /\bsuper armor\b.{0,24}\b(?:dmg|damage)\b/i.test(text)
    || /\b(?:dmg|damage)\b.{0,24}\bsuper armor\b/i.test(text);

  const add = (key, label, effectClass, extra = {}) => {
    const isSeasonalFactor = key === "season-damage" && isSeasonalPhantomFactorSource(source);
    const componentKey = isSeasonalFactor ? "seasonal-factor-damage" : key;
    const componentLabel = isSeasonalFactor ? "Seasonal Factor DMG" : label;
    const componentClass = isSeasonalFactor ? "seasonal-factor-damage" : effectClass;
    if (components.some((component) => component.componentKey === componentKey)) return;
    const gradeValueTexts = modifierEvidenceGradeValueTexts(source, componentKey, componentClass);
    components.push(inferredComponent(componentKey, componentLabel, componentClass, order++, {
      ...extra,
      valueTexts: gradeValueTexts.length ? gradeValueTexts : (extra.valueTexts ?? valueTexts),
      valueTextSource: gradeValueTexts.length ? "modifierEvidence.gradeRows" : extra.valueTextSource,
    }));
  };

  const targetPredicate = {};
  const predicateTags = [];
  if (/\b(elite|elites|boss|stronger enemies|stronger enemy)\b/i.test(text)) {
    targetPredicate.monsterRankAtLeast = "elite";
    predicateTags.push("target.elite-or-stronger");
  }
  if (/\b(marked|mark|target's location|target location|vulnerable)\b/i.test(text)) {
    predicateTags.push("target.state-or-debuff");
  }
  const sourcePredicate = {};
  if (/\b(companion|companions|summon|summons|summoned|pet|beast|falcon|phantom)\b/i.test(text)) {
    sourcePredicate.actorKind = "companion-or-summon";
    predicateTags.push("source.companion-or-summon");
  }
  const activationPredicate = {};
  if (
    /\b(while|during|throughout|duration|for \d+(?:\.\d+)?s|lasting \d+(?:\.\d+)?s|focus is active|when .+ active)\b/i.test(text)
    || String(source.runtimeDetection ?? "").includes("active-buff")
  ) {
    activationPredicate.kind = "active-modifier-window";
    predicateTags.push("activation.active-modifier-window");
  }

  if (sourceHasIcdLockoutDescription(source)) {
    const lockoutSeconds = sourceIcdLockoutSeconds(source);
    add("icd-lockout", "ICD / Lockout", "cooldown-or-resource", {
      direction: "timing",
      predicateTags: uniqueStrings([...predicateTags, "runtime.icd-lockout"]),
      activationPredicate,
      valueTexts: lockoutSeconds ? [`${lockoutSeconds}s lockout`] : valueTexts,
    });
  }

  const criticalDamageClauses = effectClauses.filter((clause) =>
    CRITICAL_DAMAGE_TEXT.test(clause) && clauseEligibleForFormulaStat(clause)
  );
  const criticalRateClauses = effectClauses.filter((clause) =>
    (CRITICAL_RATE_TEXT.test(clause) || clauseIsCriticalRate(clause) || clauseHasCriticalRateAndDamage(clause)) && clauseEligibleForFormulaStat(clause)
  );
  const criticalDamageText = criticalDamageClauses.length > 0
    || (effectClauses.length === 0 && CRITICAL_DAMAGE_TEXT.test(text) && clauseEligibleForFormulaStat(text));
  const criticalRateText = criticalRateClauses.length > 0
    || (
      effectClauses.length === 0
      && /\bcrit(?:ical)?\b/i.test(text)
      && !CRITICAL_DAMAGE_TEXT.test(text)
      && clauseEligibleForFormulaStat(text)
    );

  if (criticalDamageText) {
    add("critical-damage", "Crit DMG", "critical-damage-stat", {
      direction: "stat",
    stat: "Crit DMG",
      valueTexts: uniqueValueTextsFromClauses(criticalDamageClauses).length
        ? uniqueValueTextsFromClauses(criticalDamageClauses)
        : valueTexts,
      valueScope: valueScopeForClauses(criticalDamageClauses, effectClauses),
      predicateTags,
      targetPredicate,
      sourcePredicate,
      activationPredicate,
    });
  }
  if (criticalRateText) {
    add("critical-rate", "Crit", "critical-stat", {
      direction: "stat",
      stat: "Crit",
      valueTexts: uniqueValueTextsFromClauses(criticalRateClauses).length
        ? uniqueValueTextsFromClauses(criticalRateClauses)
        : valueTexts,
      valueScope: valueScopeForClauses(criticalRateClauses, effectClauses),
      predicateTags,
      targetPredicate,
      sourcePredicate,
      activationPredicate,
    });
  }
  if (/\bhaste\b|\battack\s*spd\b|\battack speed\b|\banimation speed\b/i.test(text)) {
    add("haste-or-attack-speed", "Haste / Attack Speed", "hit-timing", {
      direction: "timing",
      stat: "Haste",
      predicateTags,
      activationPredicate,
    });
  }
  if (/\bcd\b|\bcooldown\b|\bresource\b|\benergy\b/i.test(text)) {
    add("cooldown-or-resource", "Cooldown / Resource", "cooldown-or-resource", {
      direction: "timing",
      predicateTags,
      activationPredicate,
    });
  }
  const primaryStatClauses = statConversionClauses.filter((clause) =>
    PRIMARY_STAT_CONVERSION_TEXT.test(clause) && clauseEligibleForFormulaStat(clause)
  );
  if (primaryStatClauses.length > 0 || PRIMARY_STAT_CONVERSION_TEXT.test(statConversionText)) {
    const primaryStatValueTexts = uniqueValueTextsFromClauses(primaryStatClauses);
    add("adaptive-primary-stat", "Adaptive Primary Stat", "stat-conversion", {
      direction: "stat-conversion",
      stat: "adaptivePrimary",
      formulaTermIds: ["adaptivePrimaryStat"],
      contributionGroups: ["statConversion"],
      valueTexts: primaryStatValueTexts.length ? primaryStatValueTexts : statConversionValueTexts,
      valueScope: valueScopeForClauses(primaryStatClauses, statConversionClauses),
      predicateTags,
      activationPredicate,
      requiredRuntimeEvidence: ["attacker primary-stat/agility snapshot at hit time"],
    });
  }
  const matkClauses = effectClauses.filter((clause) => /\bmatk\b|\bmagic attack\b/i.test(clause));
  if (matkClauses.length > 0 || /\bmatk\b|\bmagic attack\b/i.test(text)) {
    add("matk", "MATK", "offense-stat", {
      direction: "stat",
      stat: "MATK",
      valueTexts: uniqueValueTextsFromClauses(matkClauses).length
        ? uniqueValueTextsFromClauses(matkClauses)
        : valueTexts,
      predicateTags,
      activationPredicate,
    });
  }
  const atkClauses = effectClauses.filter((clause) => !clauseLooksLikeSkillCoefficient(clause) && hasAttackStatText(clause));
  if (atkClauses.length > 0 || hasAttackStatText(text)) {
    add("atk", "ATK", "offense-stat", {
      direction: "stat",
      stat: "ATK",
      valueTexts: uniqueValueTextsFromClauses(atkClauses).length
        ? uniqueValueTextsFromClauses(atkClauses)
        : valueTexts,
      predicateTags,
      activationPredicate,
    });
  }
  if (/\bversatility\b/i.test(text)) {
    add("versatility", "Versatility", "versatility-stat", {
      direction: "stat",
      stat: "Versatility",
      predicateTags,
      activationPredicate,
    });
  }
  const physicalMagicDamageClauses = effectClauses.filter((clause) =>
    !clauseLooksLikeSkillCoefficient(clause) && PHYSICAL_MAGIC_DAMAGE_TEXT.test(clause)
  );
  const finalDamageClauses = effectClauses.filter((clause) => FINAL_DAMAGE_TEXT.test(clause));
  const seasonDamageClauses = effectClauses.filter((clause) => SEASON_DAMAGE_TEXT.test(clause));
  const seasonSuppressionClauses = effectClauses.filter((clause) => SEASON_SUPPRESSION_TEXT.test(clause));
  if (physicalMagicDamageClauses.length > 0 || PHYSICAL_MAGIC_DAMAGE_TEXT.test(text)) {
    add("physical-magic-enhancement", "Physical/Magic Enhancement", "physical-magic-enhancement", {
      direction: "damage-dealt",
      valueTexts: uniqueValueTextsFromClauses(physicalMagicDamageClauses).length
        ? uniqueValueTextsFromClauses(physicalMagicDamageClauses)
        : valueTexts,
      valueScope: valueScopeForClauses(physicalMagicDamageClauses, effectClauses),
      predicateTags,
      targetPredicate,
      activationPredicate,
    });
  }
  if (finalDamageClauses.length > 0 || FINAL_DAMAGE_TEXT.test(text)) {
    add("final-damage", "Final DMG", "final-damage", {
      direction: "damage-dealt",
      valueTexts: uniqueValueTextsFromClauses(finalDamageClauses).length
        ? uniqueValueTextsFromClauses(finalDamageClauses)
        : valueTexts,
      valueScope: valueScopeForClauses(finalDamageClauses, effectClauses),
      predicateTags,
      targetPredicate,
      activationPredicate,
    });
  }
  if (seasonDamageClauses.length > 0 || SEASON_DAMAGE_TEXT.test(text)) {
    add("season-damage", "Season DMG", "season-damage", {
      direction: "damage-dealt",
      valueTexts: uniqueValueTextsFromClauses(seasonDamageClauses).length
        ? uniqueValueTextsFromClauses(seasonDamageClauses)
        : valueTexts,
      valueScope: valueScopeForClauses(seasonDamageClauses, effectClauses),
      predicateTags,
      targetPredicate,
      activationPredicate,
    });
  }
  if (seasonSuppressionClauses.length > 0 || SEASON_SUPPRESSION_TEXT.test(text)) {
    add("season-suppression", "Season Suppression", "season-suppression", {
      direction: "damage-dealt",
      valueTexts: uniqueValueTextsFromClauses(seasonSuppressionClauses).length
        ? uniqueValueTextsFromClauses(seasonSuppressionClauses)
        : valueTexts,
      valueScope: valueScopeForClauses(seasonSuppressionClauses, effectClauses),
      predicateTags,
      targetPredicate,
      activationPredicate,
    });
  }
  const elementalDamageText = /\b(light|fire|ice|thunder|dark|elemental)\b.*\b(dmg|damage|strength)\b|\b(dmg|damage)\b.*\b(light|fire|ice|thunder|dark|elemental)\b/i.test(text);
  const seasonalFactorAlreadyClassified = components.some((component) => component.componentKey === "seasonal-factor-damage");
  if (elementalDamageText && !(isSeasonalPhantomFactorSource(source) && seasonalFactorAlreadyClassified)) {
    add("elemental-damage", "Elemental DMG", "elemental-damage", {
      direction: "damage-dealt",
      predicateTags,
      targetPredicate,
      activationPredicate,
    });
  }
  if (targetResistanceMitigationText) {
    add("target-resistance-mitigation", "Target Resistance", "target-mitigation", {
      direction: "target-mitigation",
      contributionScope: "targeted",
      predicateTags: uniqueStrings([...predicateTags, "target.resistance"]),
      targetPredicate,
      activationPredicate,
    });
  }
  if (targetArmorMitigationText) {
    add("target-armor-mitigation", "Target Armor / Defense", "target-armor-mitigation", {
      direction: "target-mitigation",
      contributionScope: "targeted",
      predicateTags: uniqueStrings([...predicateTags, "target.armor-or-defense"]),
      targetPredicate,
      activationPredicate,
    });
  }
  if (armorScalingDamageText) {
    add("armor-scaling-damage", "Armor / Defense Scaling Damage", "armor-scaling-damage", {
      direction: "damage-dealt",
      contributionScope: "produced-damage-row",
      predicateTags: uniqueStrings([...predicateTags, "source.armor-or-defense-scaling"]),
      sourcePredicate,
      activationPredicate,
    });
  }
  if (superArmorDamageText) {
    add("super-armor-damage", "Super Armor Damage", "proc-damage", {
      direction: "damage-dealt",
      contributionScope: "produced-damage-row",
      predicateTags: uniqueStrings([...predicateTags, "target.super-armor"]),
      targetPredicate,
      activationPredicate,
    });
  }
  if (/\b(lifesteal|life steal|healing|heals?|hp recovery|recover(?:s|ed)? hp|restore(?:s|d)? hp)\b/i.test(text)) {
    add("healing-or-lifesteal", "Healing / Lifesteal", "healing-or-lifesteal", {
      direction: "healing",
      predicateTags,
      activationPredicate,
    });
  }
  if (!superArmorDamageText && /\bshield|barrier|super armor\b/i.test(text)) {
    add("shield-or-barrier", "Shield / Barrier", "shield-or-barrier", {
      direction: "defense",
      predicateTags,
      activationPredicate,
    });
  }
  if (
    !targetArmorMitigationText
    && !targetResistanceMitigationText
    && !armorScalingDamageText
    && /\b(damage taken|dmg taken|damage reduction|dmg reduction|reduction|armor|defen[cs]e|resistance|resist)\b/i.test(text)
  ) {
    add("damage-reduction-or-defense", "Damage Reduction / Defense", "damage-reduction", {
      direction: "damage-taken",
      predicateTags,
      attackerPredicate: targetPredicate,
      activationPredicate,
    });
  }

  const damageModifierClauses = effectClauses.filter((clause) =>
    !CRITICAL_DAMAGE_TEXT.test(clause)
    && !clauseIsCriticalRate(clause)
    && !PHYSICAL_MAGIC_DAMAGE_TEXT.test(clause)
    && !FINAL_DAMAGE_TEXT.test(clause)
    && !SEASON_DAMAGE_TEXT.test(clause)
    && !SEASON_SUPPRESSION_TEXT.test(clause)
    && !clauseLooksLikeSkillCoefficient(clause)
    && !clauseIsHealingOrLifesteal(clause)
    && /\b(more dmg|more damage|damage dealt|dmg dealt|skill damage|dmg to|damage to|boosting .*damage|increases? .*dmg|increases? .*damage|deal .*more dmg|deal .*more damage)\b/i.test(clause)
  );
  const damageModifierText =
    !armorScalingDamageText
    && !superArmorDamageText
    && damageModifierClauses.length > 0;
  const producedDamageText = /\b(summons?|creates?|fires?|launches?|dealing|deals?)\b.*\b(dmg|damage)\b/i.test(text)
    && !damageModifierText;
  if (damageModifierText) {
    add("generic-damage", "Generic DMG", "damage-modifier", {
      direction: "damage-dealt",
      contributionScope: Object.keys(targetPredicate).length ? "targeted" : "global",
      valueTexts: uniqueValueTextsFromClauses(damageModifierClauses).length
        ? uniqueValueTextsFromClauses(damageModifierClauses)
        : valueTexts,
      valueScope: valueScopeForClauses(damageModifierClauses, effectClauses),
      predicateTags,
      targetPredicate,
      sourcePredicate,
      activationPredicate,
    });
  } else if (producedDamageText) {
    add("produced-damage", "Produced Damage", "proc-damage", {
      direction: "damage-dealt",
      contributionScope: "produced-damage-row",
      predicateTags,
      targetPredicate,
      sourcePredicate,
      activationPredicate,
    });
  }

  if (
    components.length === 0
    && sourceHasProducedDamageTargets(source)
    && !sourceHasModifierTargets(source)
    && !sourceHasActivationAliasEvidence(source)
  ) {
    add("produced-damage", "Produced Damage", "proc-damage", {
      direction: "damage-dealt",
      contributionScope: "produced-damage-row",
      predicateTags: ["relationship.produced-damage-row"],
    });
  }

  return mergeEffectComponents([], components);
}

function hasAttackStatText(text) {
  const value = String(text ?? "");
  if (clauseLooksLikeSkillCoefficient(value)) return false;
  if (clauseIsProducedDamageFormula(value)) return false;
  if (/\batk\b/i.test(value)) return true;
  if (/\battack\s*(?:speed|spd|dmg|damage)\b/i.test(value)) return false;
  if (/\b(?:basic|normal|special|melee|ranged)\s+attack\b/i.test(value)) return false;
  return /\battack\b\s*(?:[+-]?\d+(?:[.,]\d+)?\s*%?|\+|-|\bincreases?\b|\bboosts?\b|\bup\b|\bby\b)/i.test(value)
    || /\b(?:increases?|boosts?|grants?|gain(?:s)?|raises?)\s+(?:your\s+)?attack\b/i.test(value);
}

function normalizeComponentForAttribution(component) {
  const info = componentFormulaInfo(component);
  return stripUndefined({
    componentKey: component.componentKey,
    label: component.label,
    effectClass: component.effectClass,
    contributionScope: component.contributionScope,
    direction: component.direction,
    stat: component.stat,
    valueScope: component.valueScope,
    formulaTermIds: info.formulaTermIds,
    contributionGroups: info.contributionGroups,
    predicateTags: info.predicateTags,
    requiredRuntimeEvidence: info.requiredRuntimeEvidence,
    valueTexts: component.valueTexts,
    baseValues: component.baseValues,
    valueTiers: component.valueTiers,
    targetPredicate: component.targetPredicate,
    attackerPredicate: component.attackerPredicate,
    sourcePredicate: component.sourcePredicate,
    activationPredicate: component.activationPredicate,
    valueTextSource: component.valueTextSource,
    inferenceSource: component.inferenceSource,
  });
}

function attributionStatusForSource(source, components, formulaTermIds, contributionGroups) {
  const sourceName = preferredName(source.sourceNames, source.sourceName);
  if (/^Unmapped Buff \d+$/i.test(sourceName)) return "needs-source-localization";
  if (String(source.sourceType ?? "").includes("icd")) return "timing-only";
  if (components.length === 0) {
    return String(source.runtimeDetection ?? "").includes("active-buff")
      ? "uptime-only"
      : "needs-component-classification";
  }
  const classes = new Set(components.map((component) => component.effectClass));
  const nonDamage = new Set(["damage-reduction", "defense-stat", "resource-stat", "healing-or-lifesteal", "shield-or-barrier"]);
  if ([...classes].every((value) => nonDamage.has(value))) return "defensive-or-non-damage";
  if ([...classes].every((value) => value === "proc-damage")) return "proc-damage";
  if (formulaTermIds.length > 0) return "formula-ready-candidate";
  if (contributionGroups.includes("hitTiming")) return "timing-only";
  return "needs-component-classification";
}

function attributionConfidence(source, components, formulaTermIds) {
  if (components.some((component) => component.inferenceSource === "EffectSources.formulaAttributionText")) {
    return formulaTermIds.length > 0 ? "medium" : "low";
  }
  if (components.length > 0) return "high";
  if (sourceHasProducedDamageTargets(source)) return "medium";
  return "low";
}

function buildAttributionModel(source) {
  const existingComponents = source.effectComponents ?? [];
  const shouldInferComponents = existingComponents.length === 0
    || existingComponents.every((component) => component.effectClass === "unknown-effect");
  const hasIcdLockout = String(source.sourceType ?? "").includes("icd")
    || sourceHasIcdLockoutDescription(source);
  if (hasIcdLockout) {
    source.effectTags = uniqueStrings([...(source.effectTags ?? []), "icd-lockout"]);
    const lockoutSeconds = sourceIcdLockoutSeconds(source);
    if (lockoutSeconds) {
      source.icdLockoutSeconds = lockoutSeconds;
    }
  }
  const components = mergeEffectComponents(
    existingComponents,
    shouldInferComponents ? inferEffectComponentsFromSource(source) : [],
  );
  source.effectComponents = components;

  const attributionComponents = components
    .map(normalizeComponentForAttribution)
    .filter(Boolean);
  const formulaTermIds = uniqueStrings(attributionComponents.flatMap((component) => component.formulaTermIds ?? []));
  const contributionGroups = uniqueStrings(attributionComponents.flatMap((component) => component.contributionGroups ?? []));
  const predicateTags = uniqueStrings(attributionComponents.flatMap((component) => component.predicateTags ?? []));
  const requiredRuntimeEvidence = uniqueStrings(attributionComponents.flatMap((component) => component.requiredRuntimeEvidence ?? []));
  const relationshipKinds = sourceRelationshipKinds(source);
  const status = attributionStatusForSource(source, components, formulaTermIds, contributionGroups);
  const notes = [
    "Observed damage/hits are window overlap evidence, not solved net-added damage.",
    formulaTermIds.length > 0
      ? "Formula replay must compare the observed hit against a counterfactual hit with this source removed."
      : "",
    sourceHasProducedDamageTargets(source) && !sourceHasModifierTargets(source)
      ? "Produced/proc damage rows should be attributed by their own damage rows, not treated as a parent-hit multiplier."
      : "",
    hasIcdLockout
      ? "ICD/lockout rows describe timing suppression windows, not direct damage contribution."
      : "",
  ].filter(Boolean);

  return stripUndefined({
    schemaVersion: 1,
    damageFormulaId: DAMAGE_FORMULA_ID,
    status,
    confidence: attributionConfidence(source, components, formulaTermIds),
    formulaTermIds,
    contributionGroups,
    predicateTags,
    requiredRuntimeEvidence,
    relationshipKinds,
    components: attributionComponents,
    notes,
  });
}

function addFormulaAttributionLayer(builder) {
  for (const source of Object.values(builder.effectSourcesById)) {
    source.attributionModel = buildAttributionModel(source);
    builder.effectSourcesById[source.sourceId] = stripUndefined(source);
  }
}

function countAttributionStatuses(effectSourcesById, ids) {
  const counts = {};
  for (const id of ids) {
    const status = effectSourcesById[id]?.attributionModel?.status ?? "missing";
    counts[status] = (counts[status] ?? 0) + 1;
  }
  return Object.fromEntries(Object.entries(counts).sort(([left], [right]) => left.localeCompare(right)));
}

function addIndex(index, rawId, sourceId) {
  const id = toNumber(rawId);
  if (id === null) return;
  const key = String(id);
  index[key] = uniqueStrings([...(index[key] ?? []), sourceId]);
}

function collectRecountRows(recount) {
  return Object.values(recount ?? {})
    .map((row) => stripUndefined({
      recountId: toNumber(row.Id),
      recountName: row.RecountName ?? row.Name,
      recountNames: normalizedNames(row.Names, row.RecountName ?? row.Name),
      damageIds: uniqueNumbers(row.DamageId ?? []),
      linkedTalentId: toNumber(row.LinkedTalentId),
      linkedTalentName: row.LinkedTalentName,
      linkedTalentNames: row.LinkedTalentNames,
      linkedTalentBuffIds: uniqueNumbers(row.LinkedTalentBuffIds ?? []),
      linkedTalentFormulaIds: uniqueNumbers(row.LinkedTalentFormulaIds ?? []),
      talentBridge: row.TalentBridge,
    }))
    .filter((row) => row?.recountId);
}

function buildRecountNameIndex(recountRows) {
  const index = new Map();
  for (const row of recountRows) {
    for (const [localeId, name] of Object.entries(row.recountNames ?? {})) {
      const normalized = normalizeLabel(name);
      if (!normalized) continue;
      const key = `${localeId}|${normalized}`;
      const current = index.get(key) ?? [];
      current.push(row);
      index.set(key, current);
    }
  }
  return index;
}

function isBuffSourceId(sourceId) {
  return String(sourceId ?? "").startsWith("buff-source:");
}

function hasEnglishSourceName(source) {
  return Boolean(source?.sourceNames?.en);
}

function isDesignOnlyBuffSource(sourceId, source) {
  return isBuffSourceId(sourceId) && !hasEnglishSourceName(source);
}

function sourceMergePriority(sourceId, source) {
  if (String(sourceId).startsWith("phantom-factor:")) return 100;
  if (String(sourceId).startsWith("talent:") || source?.sourceType === "talent") return 90;
  if (String(sourceId).startsWith("season-talent:")) return 80;
  if (String(sourceId).startsWith("season-rogue:")) return 75;
  if (source?.sourceKind === "consumable") return 70;
  return 10;
}

function findLocalizedSiblingSource(builder, sourceId, source) {
  const candidateIds = uniqueStrings(
    (source.buffIds ?? [])
      .flatMap((buffId) => builder.buffIdToEffectSourceIds[String(buffId)] ?? []),
  );
  return candidateIds
    .filter((candidateId) => candidateId !== sourceId && !isBuffSourceId(candidateId))
    .map((candidateId) => ({
      candidateId,
      source: builder.effectSourcesById[candidateId],
    }))
    .filter((candidate) => hasEnglishSourceName(candidate.source))
    .sort((left, right) =>
      sourceMergePriority(right.candidateId, right.source)
        - sourceMergePriority(left.candidateId, left.source)
      || left.candidateId.localeCompare(right.candidateId),
    )[0];
}

function sourceRecountRows(builder, source) {
  const rowById = new Map(builder.recountRows.map((row) => [String(row.recountId), row]));
  return uniqueNumbers(
    (source.targets ?? []).flatMap((target) => [target.recountId, target.parentRecountId]),
  )
    .map((recountId) => rowById.get(String(recountId)))
    .filter((row) => row?.recountNames?.en);
}

function mergeDesignOnlyBuffSource(builder, sourceId, targetId) {
  const source = builder.effectSourcesById[sourceId];
  const target = builder.effectSourcesById[targetId];
  if (!source || !target) return false;

  target.buffIds = uniqueNumbers([...(target.buffIds ?? []), ...(source.buffIds ?? [])]);
  target.classGateIds = uniqueNumbers([...(target.classGateIds ?? []), ...(source.classGateIds ?? [])]);
  target.targets = mergeTargets(target.targets, source.targets);
  target.evidence = mergeEvidence(target.evidence, [
    ...(source.evidence ?? []),
    {
      source: "EffectSources.gen",
      relationshipKind: "collapsed-design-only-buff-source",
      evidenceStatus: "same-runtime-buff-id-has-localized-generated-source",
      fromSourceId: sourceId,
      intoSourceId: targetId,
      buffIds: source.buffIds,
      designName: source.sourceNames?.design ?? source.sourceName,
    },
  ]);
  target.sourceNames = mergeNameMaps(target.sourceNames, source.sourceNames);
  target.runtimeDetection = mergeRuntimeDetection(target.runtimeDetection, source.runtimeDetection);
  target.iconPath ||= source.iconPath;

  builder.effectSourcesById[targetId] = stripUndefined(target);
  delete builder.effectSourcesById[sourceId];
  return true;
}

function applyRecountNameFallback(builder, sourceId, source) {
  const recountRows = sourceRecountRows(builder, source);
  if (recountRows.length !== 1) return false;

  const [recountRow] = recountRows;
  source.sourceNames = mergeNameMaps(source.sourceNames, recountRow.recountNames);
  source.sourceName = preferredName(source.sourceNames, source.sourceName);
  source.evidence = mergeEvidence(source.evidence, [{
    source: "EffectSources.gen",
    relationshipKind: "design-only-buff-source-recount-name-fallback",
    evidenceStatus: "unique-localized-parent-recount-row",
    recountId: recountRow.recountId,
    recountName: recountRow.recountName,
    buffIds: source.buffIds,
    designName: source.sourceNames?.design,
  }]);
  builder.effectSourcesById[sourceId] = stripUndefined(source);
  return true;
}

function applyDesignOnlyBuffNameFallback(builder, sourceId, source) {
  const buffId = toNumber(source.sourceEntityId) ?? toNumber(source.buffIds?.[0]);
  const parts = splitDesignNameParts(source.sourceNames?.design);
  if (buffId === null || !parts) return false;

  const ownerEvidence = (source.evidence ?? []).find((item) => item?.ownerToken || item?.ownerMatchKind);
  const ownerMatch = ownerEvidence?.ownerMatchKind
    ? { owner: { matchKind: ownerEvidence.ownerMatchKind } }
    : null;
  const ownerName = englishDesignOwnerFallback(parts.ownerToken, ownerMatch);
  const suffixName = englishDesignSuffixFallback(parts.suffix);
  if (!ownerName || !suffixName) return false;

  source.sourceNames = mergeNameMaps(source.sourceNames, {
    en: `${ownerName} - ${suffixName}`,
    design: `${parts.ownerToken} - ${parts.suffix}`,
  });
  source.sourceName = preferredName(source.sourceNames, `Buff ${buffId}`);
  source.evidence = mergeEvidence(source.evidence, [{
    source: "EffectSources.gen",
    relationshipKind: "design-only-buff-source-name-fallback",
    evidenceStatus: "owner-token-and-known-design-suffix",
    buffSourceId: buffId,
    designName: source.sourceNames?.design,
  }]);
  builder.effectSourcesById[sourceId] = stripUndefined(source);
  return true;
}

function applyUnmappedBuffPlaceholder(builder, sourceId, source) {
  const buffId = toNumber(source.sourceEntityId) ?? toNumber(source.buffIds?.[0]);
  if (buffId === null) return false;
  source.sourceNames = {
    ...localizedUnmappedBuffNames(buffId),
    ...(source.sourceNames ?? {}),
  };
  source.sourceName = preferredName(source.sourceNames, `Unmapped Buff ${buffId}`);
  source.evidence = mergeEvidence(source.evidence, [{
    source: "EffectSources.gen",
    relationshipKind: "design-only-buff-source-unmapped-placeholder",
    evidenceStatus: "no-localized-sibling-or-unique-recount-row",
    buffSourceId: buffId,
    designName: source.sourceNames?.design,
    placeholderLocales: LOCALES,
  }]);
  builder.effectSourcesById[sourceId] = stripUndefined(source);
  return true;
}

function localizedUnmappedBuffNames(buffId) {
  const out = {};
  for (const localeId of LOCALES) {
    out[localeId] = `${UNMAPPED_BUFF_LABELS[localeId] ?? UNMAPPED_BUFF_LABELS.en} ${buffId}`;
  }
  return out;
}

function rebuildSourceIndexes(builder) {
  builder.buffIdToEffectSourceIds = {};
  builder.damageIdToEffectSourceIds = {};
  builder.recountIdToEffectSourceIds = {};

  for (const [sourceId, source] of Object.entries(builder.effectSourcesById)) {
    for (const buffId of source.buffIds ?? []) {
      addIndex(builder.buffIdToEffectSourceIds, buffId, sourceId);
    }
    for (const target of source.targets ?? []) {
      if (target.targetKind === "damage" && target.damageId) {
        addIndex(builder.damageIdToEffectSourceIds, target.damageId, sourceId);
      } else if (target.targetKind === "recount" && target.recountId) {
        addIndex(builder.recountIdToEffectSourceIds, target.recountId, sourceId);
      }
    }
  }
}

function postProcessDesignOnlyBuffSources(builder) {
  const summary = {
    collapsedDesignOnlyBuffSources: 0,
    recountNamedDesignOnlyBuffSources: 0,
    unresolvedDesignOnlyBuffSources: 0,
    placeholderNamedDesignOnlyBuffSources: 0,
  };

  for (const [sourceId, source] of Object.entries({ ...builder.effectSourcesById })) {
    if (!isDesignOnlyBuffSource(sourceId, source)) continue;
    const sibling = findLocalizedSiblingSource(builder, sourceId, source);
    if (sibling && mergeDesignOnlyBuffSource(builder, sourceId, sibling.candidateId)) {
      summary.collapsedDesignOnlyBuffSources += 1;
    }
  }

  rebuildSourceIndexes(builder);

  for (const [sourceId, source] of Object.entries(builder.effectSourcesById)) {
    if (!isDesignOnlyBuffSource(sourceId, source)) continue;
    if (applyRecountNameFallback(builder, sourceId, source)) {
      summary.recountNamedDesignOnlyBuffSources += 1;
    }
  }

  for (const [sourceId, source] of Object.entries(builder.effectSourcesById)) {
    if (isDesignOnlyBuffSource(sourceId, source)) {
      summary.unresolvedDesignOnlyBuffSources += 1;
      if (applyDesignOnlyBuffNameFallback(builder, sourceId, source)) {
        summary.placeholderNamedDesignOnlyBuffSources += 1;
      } else if (applyUnmappedBuffPlaceholder(builder, sourceId, source)) {
        summary.placeholderNamedDesignOnlyBuffSources += 1;
      }
    }
  }

  rebuildSourceIndexes(builder);
  builder.postProcessSummary = summary;
}

function addPhantomFactors(builder, factorData) {
  for (const factor of Object.values(factorData?.factorsByBuffId ?? {})) {
    const sourceId = `phantom-factor:${factor.buffId}`;
    const targets = [];
    for (const [damageId, evidence] of Object.entries(factor.affectedDamageEvidence ?? {})) {
      targets.push({
        targetKind: "damage",
        damageId: toNumber(damageId),
        relationshipKind: "direct-linked-factor-damage-row",
        evidenceSource: evidence.source,
        evidenceStatus: "current-production-direct-id-link",
        sourceKind: evidence.sourceKind,
        sourceType: evidence.sourceType,
      });
    }
    for (const [recountId, evidence] of Object.entries(factor.affectedRecountEvidence ?? {})) {
      targets.push({
        targetKind: "recount",
        recountId: toNumber(recountId),
        recountName: evidence.recountName,
        relationshipKind: evidence.relationshipKind,
        evidenceSource: evidence.source,
        evidenceStatus: (evidence.evidenceStatuses ?? []).join(","),
        sourceTable: evidence.sourceTable,
        descriptionId: evidence.descriptionId,
        localeId: evidence.localeId,
        targetText: evidence.targetText,
        candidateText: evidence.candidateText,
        matchedText: evidence.matchedText,
      });
    }
    builder.upsertSource({
      sourceId,
      sourceKind: "phantom-factor",
      sourceType: "season-phantom-factor",
      sourceEntityId: factor.buffId,
      familyId: factor.familyId,
      sourceName: factor.familyName,
      sourceNames: factor.familyNames,
      iconPath: factor.iconPath,
      runtimeDetection: factor.runtimeDetection ?? "active-buff",
      sourceTable: "SeasonPhantomFactorProbe",
      classGateIds: factor.classGateIds,
      buffIds: [factor.buffId],
      descriptions: factor.descriptions,
      cleanDescriptions: factor.cleanDescriptions,
      modifierEvidence: factor.modifierEvidence,
      targets,
      evidence: [{
        source: "SeasonPhantomFactors",
        relationshipPolicy: factorData.summary?.relationshipPolicy,
      }],
    });
  }
}

function addRecountTalentLinks(builder, recountRows) {
  for (const row of recountRows) {
    if (!row.linkedTalentId) continue;
    builder.upsertSource({
      sourceId: `talent:${row.linkedTalentId}`,
      sourceKind: "talent-passive",
      sourceType: "talent",
      sourceEntityId: row.linkedTalentId,
      sourceName: row.linkedTalentName,
      sourceNames: row.linkedTalentNames,
      runtimeDetection: "row-observed",
      sourceTable: "CTB:3345237628",
      buffIds: row.linkedTalentBuffIds,
      targets: [{
        targetKind: "recount",
        recountId: row.recountId,
        recountName: row.recountName,
        relationshipKind: "produces-recount-row",
        evidenceSource: "RecountTable.LinkedTalentId",
        evidenceStatus: "current-production-recount-talent-bridge",
        bridge: row.talentBridge,
        linkedFormulaIds: row.linkedTalentFormulaIds,
      }],
    });
  }
}

function aoyiValueScope(key) {
  const normalized = String(key || "").trim();
  if (normalized === "attrPer") return "owner";
  if (normalized === "attrOther") return "party";
  return "";
}

function aoyiComponentValues(values, options = {}) {
  const allowedKeys = new Set(options.keys ?? ["attrPer", "attrOther"]);
  return (values ?? [])
    .filter((value) => allowedKeys.has(value.key))
    .map((value) => stripUndefined({
      scope: value.scope || aoyiValueScope(value.key) || options.scope,
      key: value.key,
      rawText: value.valueText,
      unit: "percent",
      value: value.percentValue,
      decimalValue: value.decimalValue,
      formulaAmount: true,
      rawTableValue: value.rawValue,
    }));
}

function battleImagineTextLooksTargetVulnerability(text) {
  return /\b(?:wound|severe\s+wound|vulnerab(?:le|ility)|damage\s*(?:taken|received)\s*(?:\+|increase|more)|takes?\s+(?:[+-]?\d+(?:[.,]\d+)?\s*%\s+)?(?:more|increased)\s+(?:damage|dmg)|receives?\s+(?:[+-]?\d+(?:[.,]\d+)?\s*%\s+)?(?:more|increased)\s+(?:damage|dmg))\b/i.test(text);
}

function battleImagineValueComponentSpec(row, sourceConfigRule) {
  const text = cleanMarkup([
    row?.sourceName,
    row?.Name,
    row?.NameDesign,
    row?.DesignName,
    preferredName(row?.Names),
    preferredText(row?.CleanDescriptions),
    preferredText(row?.Descriptions),
    sourceConfigRule?.ownerName,
    preferredName(sourceConfigRule?.ownerNames),
    preferredName(sourceConfigRule?.ownerMonsterNames),
  ].filter(Boolean).join(" ")).toLowerCase();
  const requiredRuntimeEvidence = ["runtime battle imagine modification tier selection"];
  const predicateTags = ["source.battle-imagine"];

  if (/\b(?:healing|heal)\s+received\b|\breceived\s+(?:healing|heal)\b|\bhealing\s+taken\b/i.test(text)) {
    return {
      key: "healing-received",
      label: "Healing Received",
      effectClass: "healing-or-lifesteal",
      order: 1,
      extra: {
        direction: "healing",
        stat: "healing received",
        predicateTags,
        requiredRuntimeEvidence: uniqueStrings([
          ...requiredRuntimeEvidence,
          "healing event lane or healing-received stat snapshot",
        ]),
      },
    };
  }

  if (/\b(?:cooldown|cd|recast|recharge|tdr|skill\s*cds?|skill\s*cooldowns?)\b/i.test(text)) {
    return {
      key: "cooldown-or-resource",
      label: "Cooldown / Resource",
      effectClass: "cooldown-or-resource",
      order: 1,
      extra: {
        direction: "timing",
        stat: "cooldown speed",
        predicateTags,
        requiredRuntimeEvidence: uniqueStrings([
          ...requiredRuntimeEvidence,
          "cast timeline or cooldown state",
        ]),
      },
    };
  }

  if (/\b(?:haste|attack\s*speed|atk\s*speed|cast(?:ing)?\s*speed)\b/i.test(text)) {
    return {
      key: "haste-or-attack-speed",
      label: "Haste / Attack Speed",
      effectClass: "hit-timing",
      order: 1,
      extra: {
        direction: "timing",
        stat: "haste",
        predicateTags,
        requiredRuntimeEvidence: uniqueStrings([
          ...requiredRuntimeEvidence,
          "cast timeline or per-hit window buckets",
        ]),
      },
    };
  }

  if (/\bmastery\b/i.test(text)) {
    return {
      key: "mastery-stat",
      label: "Mastery",
      effectClass: "stat-conversion",
      order: 1,
      extra: {
        direction: "stat-conversion",
        stat: "mastery",
        formulaTermIds: ["masteryStat"],
        contributionGroups: ["statConversion"],
        predicateTags,
        requiredRuntimeEvidence: uniqueStrings([
          ...requiredRuntimeEvidence,
          "attacker mastery snapshot at hit time",
        ]),
      },
    };
  }

  if (battleImagineTextLooksTargetVulnerability(text)) {
    return {
      key: "target-vulnerability",
      label: "Target Vulnerability / Wound",
      effectClass: "damage-modifier",
      order: 1,
      extra: {
        contributionScope: "targeted",
        direction: "damage-dealt",
        formulaTermIds: ["genericDamagePct"],
        contributionGroups: ["genericDamage"],
        predicateTags: uniqueStrings([...predicateTags, "target.state-or-debuff"]),
        targetPredicate: { state: "vulnerability" },
        requiredRuntimeEvidence: uniqueStrings([
          ...requiredRuntimeEvidence,
          "modifier windows",
          "target uid",
        ]),
      },
    };
  }

  if (/\b(?:damage|dmg)\b.{0,60}\b(?:dealt|increase|boost|bonus|more)\b|\b(?:increase|boost|bonus|more)\b.{0,60}\b(?:damage|dmg)\b/i.test(text)) {
    return {
      key: "generic-damage",
      label: "Generic DMG",
      effectClass: "damage-modifier",
      order: 1,
      extra: {
        direction: "damage-dealt",
        formulaTermIds: ["genericDamagePct"],
        contributionGroups: ["genericDamage"],
        predicateTags,
        requiredRuntimeEvidence: uniqueStrings([
          ...requiredRuntimeEvidence,
          "modifier windows",
        ]),
      },
    };
  }

  if (hasAttackStatText(text)) {
    return {
      key: "atk",
      label: "ATK",
      effectClass: "offense-stat",
      order: 1,
      extra: {
        direction: "damage-dealt",
        stat: "attack",
        predicateTags,
        requiredRuntimeEvidence: requiredRuntimeEvidence,
      },
    };
  }

  return {
    key: "battle-imagine-value",
    label: "Battle Imagine Value",
    effectClass: "unknown-effect",
    order: 1,
    extra: {
      contributionScope: "unknown",
      predicateTags: uniqueStrings([...predicateTags, "needs.effect-component-classification"]),
      requiredRuntimeEvidence: requiredRuntimeEvidence,
    },
  };
}

function battleImagineTieredComponent(spec, baseEffect, tierRows, valueOptions = {}) {
  const baseValues = aoyiComponentValues(baseEffect?.values, valueOptions);
  const valueTiers = tierRows
    .map((row) => {
      const values = aoyiComponentValues(row.values, valueOptions);
      if (values.length === 0) return null;
      return stripUndefined({
        tier: row.tier,
        tierKind: "modification-stage",
        values,
        sourceTable: row.sourceTable,
        sourceOffset: row.sourceOffset,
        rowId: row.rowId,
      });
    })
    .filter(Boolean);

  if (baseValues.length === 0 && valueTiers.length === 0) return null;

  return inferredComponent(spec.key, spec.label, spec.effectClass, spec.order, {
    ...spec.extra,
    valueTextSource: "SkillFightLevelTable.baseEffect+SkillAoyiStarTable.modificationRows",
    baseValues: baseValues.length > 0
      ? stripUndefined({
          values: baseValues,
          sourceTable: baseEffect.sourceTable,
          sourceOffset: baseEffect.sourceOffset,
          skillLevelId: baseEffect.skillLevelId,
          skillEffectId: baseEffect.skillEffectId,
          level: baseEffect.level,
          cooldownSeconds: baseEffect.cooldownSeconds,
        })
      : undefined,
    valueTiers,
  });
}

function battleImagineTierEffectComponents(row, sourceConfigRule) {
  const baseEffect = normalizeAoyiBaseEffect(sourceConfigRule?.ownerBaseEffects);
  const tierRows = normalizeAoyiTierEffects(sourceConfigRule?.ownerTierEffects);
  const text = cleanMarkup([
    row?.sourceName,
    row?.Name,
    row?.NameDesign,
    row?.DesignName,
    preferredName(row?.Names),
    preferredText(row?.CleanDescriptions),
    preferredText(row?.Descriptions),
    sourceConfigRule?.ownerName,
    preferredName(sourceConfigRule?.ownerNames),
    preferredName(sourceConfigRule?.ownerMonsterNames),
  ].filter(Boolean).join(" "));

  if (!baseEffect && tierRows.length === 0) return [];

  const requiredRuntimeEvidence = ["runtime battle imagine modification tier selection"];
  const predicateTags = ["source.battle-imagine"];
  const hasCriticalDamage = CRITICAL_DAMAGE_TEXT.test(text);
  const hasCriticalRate = CRITICAL_RATE_TEXT.test(text)
    || clauseIsCriticalRate(text)
    || clauseHasCriticalRateAndDamage(text);
  if (hasCriticalDamage || hasCriticalRate) {
    const components = [
      hasCriticalDamage
        ? battleImagineTieredComponent({
            key: "critical-damage",
            label: "Crit DMG",
            effectClass: "critical-damage-stat",
            order: 1,
            extra: {
              direction: "stat",
              stat: "Crit DMG",
              predicateTags,
              requiredRuntimeEvidence: uniqueStrings([
                ...requiredRuntimeEvidence,
                "attacker crit-damage snapshot at hit time",
                "crit flag",
              ]),
            },
          }, baseEffect, tierRows, { keys: ["attrAdd"], scope: "owner" })
        : null,
      hasCriticalRate
        ? battleImagineTieredComponent({
            key: "critical-rate",
            label: "Crit",
            effectClass: "critical-stat",
            order: 2,
            extra: {
              direction: "stat",
              stat: "Crit",
              predicateTags,
              requiredRuntimeEvidence: uniqueStrings([
                ...requiredRuntimeEvidence,
                "attacker crit-rate snapshot at hit time",
                "crit flag",
              ]),
            },
          }, baseEffect, tierRows, { keys: ["attrPer"], scope: "owner" })
        : null,
    ].filter(Boolean);
    if (components.length > 0) return components;
  }

  const spec = battleImagineValueComponentSpec(row, sourceConfigRule);
  const component = battleImagineTieredComponent(spec, baseEffect, tierRows);
  return component ? [component] : [];
}

function sourceConfigRuleForRuntimeBuff(buffId, qualified, sourceConfigOwnerRules) {
  const rule = qualified?.sourceConfigRule
    ?? sourceConfigOwnerRules.get(buffId - 1)
    ?? sourceConfigOwnerRules.get(buffId);
  if (!rule) return undefined;
  const qualifiedOwnerId = qualified?.ownerMatch?.owner?.record?.sourceId;
  if (qualifiedOwnerId !== undefined && rule.ownerSkillId !== undefined && Number(qualifiedOwnerId) !== Number(rule.ownerSkillId)) {
    return undefined;
  }
  return rule;
}

function sourceConfigRuleForOwnerSkill(buffId, qualified, sourceConfigOwnerRules) {
  const ownerSkillId = qualified?.ownerMatch?.owner?.record?.sourceId;
  if (ownerSkillId === undefined || ownerSkillId === null) return undefined;
  const candidates = sourceConfigOwnerRules.byOwnerSkillId?.get(String(ownerSkillId)) ?? [];
  if (candidates.length === 1) return candidates[0];
  const priorCandidates = candidates
    .filter((candidate) => Number(candidate.sourceConfigId) < Number(buffId))
    .sort((left, right) => Number(right.sourceConfigId) - Number(left.sourceConfigId));
  return priorCandidates[0];
}

function addImagineBuffCatalog(builder, buffRows, ownerIndex, sourceConfigOwnerRules = new Map()) {
  for (const row of Array.isArray(buffRows) ? buffRows : Object.values(buffRows ?? {})) {
    const buffId = toNumber(row.Id);
    if (buffId === null) continue;
    const qualified = buffSourceNamesFromBuffRow(row, ownerIndex)
      ?? buffSourceNamesFromSourceConfigOwner(row, sourceConfigOwnerRules);
    if (!isLikelyImagineRuntimeBuffRow(row, qualified)) continue;
    const names = qualified?.names ?? buffRowBaseNames(row);
    const ownerMatch = qualified?.ownerMatch;
    const sourceConfigRule = sourceConfigRuleForRuntimeBuff(buffId, qualified, sourceConfigOwnerRules)
      ?? sourceConfigRuleForOwnerSkill(buffId, qualified, sourceConfigOwnerRules);
    const effectComponents = battleImagineTierEffectComponents(row, sourceConfigRule);
    builder.upsertSource({
      sourceId: `buff-source:${buffId}`,
      sourceKind: "imagine",
      sourceType: imagineRuntimeSourceType(row),
      sourceEntityId: buffId,
      sourceName: preferredName(names, row.Name ?? row.NameDesign ?? row.DesignName ?? `Buff ${buffId}`),
      sourceNames: names,
      descriptionIds: row.DescriptionId ? [row.DescriptionId] : undefined,
      descriptions: row.Descriptions,
      cleanDescriptions: row.CleanDescriptions,
      iconPath: row.IconPath,
      runtimeDetection: "active-buff",
      sourceTable: "BuffName",
      buffIds: uniqueNumbers([buffId, sourceConfigRule?.sourceConfigId]),
      effectComponents,
      evidence: [stripUndefined({
        source: "BuffName",
        buffSourceId: buffId,
        relationshipKind: "battle-imagine-runtime-buff-row",
        ownerNameSource: ownerMatch?.owner?.record?.source ?? "unresolved-buff-design",
        ownerSourceId: ownerMatch?.owner?.record?.sourceId,
        ownerMatchKind: ownerMatch?.owner?.matchKind,
        ownerToken: ownerMatch?.ownerToken,
        sourceConfigId: sourceConfigRule?.sourceConfigId,
        sourceConfigDesignName: sourceConfigRule?.sourceConfigDesignName,
        sourceConfigOwnerToken: sourceConfigRule?.sourceConfigOwnerToken,
        ownerSkillEffectId: sourceConfigRule?.ownerSkillEffectId,
        ownerBaseEffectSkillLevelId: sourceConfigRule?.ownerBaseEffects?.skillLevelId,
        ownerTierEffectTiers: sourceConfigRule?.ownerTierEffects?.map((entry) => entry.tier),
        ownerMonsterNames: sourceConfigRule?.ownerMonsterNames,
        buffDescriptionId: row.DescriptionId,
        designName: row.DesignName ?? row.NameDesign,
      })],
    });
  }
}

function addDesignOnlyRuntimeBuffCatalog(builder, buffRows, ownerIndex) {
  for (const row of Array.isArray(buffRows) ? buffRows : Object.values(buffRows ?? {})) {
    const buffId = toNumber(row.Id);
    if (buffId === null) continue;
    if (sourceHasBuffIndex(builder, buffId)) continue;
    const fallback = designOnlyRuntimeBuffNames(row, ownerIndex);
    if (!fallback) continue;
    builder.upsertSource({
      sourceId: `buff-source:${buffId}`,
      sourceKind: "runtime-buff",
      sourceType: designOnlyRuntimeSourceType(row),
      sourceEntityId: buffId,
      sourceName: preferredName(fallback.names, row.Name ?? row.NameDesign ?? row.DesignName ?? `Buff ${buffId}`),
      sourceNames: fallback.names,
      iconPath: row.IconPath,
      runtimeDetection: "active-buff",
      sourceTable: "BuffName",
      buffIds: [buffId],
      evidence: [stripUndefined({
        source: "BuffName",
        buffSourceId: buffId,
        relationshipKind: "design-only-runtime-buff-row",
        ownerNameSource: fallback.ownerMatch?.owner?.record?.source,
        ownerSourceId: fallback.ownerMatch?.owner?.record?.sourceId,
        ownerMatchKind: fallback.ownerMatch?.owner?.matchKind,
        ownerToken: fallback.ownerMatch?.ownerToken,
        designName: row.DesignName ?? row.NameDesign,
      })],
    });
  }
}

function addRecountMatchedBuffCatalog(builder, buffRows) {
  for (const row of Array.isArray(buffRows) ? buffRows : Object.values(buffRows ?? {})) {
    const buffId = toNumber(row.Id);
    if (buffId === null) continue;
    if (sourceHasBuffIndex(builder, buffId)) continue;
    const recountRow = findUniqueRecountNameMatch(row, builder.recountNameIndex);
    if (!recountRow) continue;
    builder.upsertSource({
      sourceId: `buff-source:${buffId}`,
      sourceKind: "active-skill",
      sourceType: "active-skill-buff",
      sourceEntityId: buffId,
      sourceName: preferredName(buffRowBaseNames(row), recountRow.recountName ?? `Buff ${buffId}`),
      sourceNames: mergeNameMaps(buffRowBaseNames(row), recountRow.recountNames),
      iconPath: row.IconPath || recountRow.iconPath,
      runtimeDetection: "active-buff",
      sourceTable: "BuffName",
      buffIds: [buffId],
      evidence: [stripUndefined({
        source: "BuffName.RecountTable.localizedNameMatch",
        buffSourceId: buffId,
        recountId: recountRow.recountId,
        recountName: recountRow.recountName,
        relationshipKind: "active-skill-runtime-buff-row",
        designName: row.DesignName ?? row.NameDesign,
      })],
    });
  }
}

function consumableBuffKind(row) {
  const buffId = toNumber(row.Id);
  if (buffId === null) return null;
  const iconPath = String(row.IconPath ?? "");
  const name = preferredName(
    normalizedNames(row.Names, row.Name ?? row.NameDesign ?? row.DesignName),
    row.Name ?? row.NameDesign ?? row.DesignName ?? "",
  ).toLowerCase();
  if (
    buffId >= 2032000
    && buffId < 2033000
    && iconPath === "ui/atlas/buff/buff_food_up"
    && name === "cuisine"
  ) {
    return "food";
  }
  if (
    buffId >= 2033000
    && buffId < 2034000
    && iconPath === "ui/atlas/buff/buff_agentia_up"
    && name === "potion"
  ) {
    return "potion";
  }
  return null;
}

function buildItemIdIndex(items) {
  const byId = new Map();
  for (const row of Array.isArray(items) ? items : Object.values(items ?? {})) {
    const itemId = toNumber(row.Id);
    if (itemId === null) continue;
    byId.set(itemId, row);
  }
  return byId;
}

function consumableItemCandidate(buffId, kind, itemById) {
  const suffix = buffId % 1000;
  const itemId = (kind === "food" ? 1012000 : 1015000) + suffix;
  const row = itemById.get(itemId);
  if (!row) return null;
  const iconPath = String(row.IconPath ?? "");
  const nameText = [
    row.NameDesign,
    row.Name,
    ...Object.values(row.Names ?? {}),
  ].filter(Boolean).join(" ");
  if (kind === "food") {
    if (iconPath.includes("cuisine") || /skewer|stew|juice|soup|fish|meal|food|toast|hotpot|pan-seared/i.test(nameText)) {
      return { itemId, row };
    }
  } else if (/syrup|pastille|serum|drop|potion|agentia/i.test(`${iconPath} ${nameText}`)) {
    return { itemId, row };
  }
  return null;
}

function translateFoodDesignName(rawName) {
  let text = String(rawName || "").trim();
  if (!text) return "";
  const replacements = [
    ["生命恢复", "HP Regen"],
    ["精英增伤", "DMG to Elites"],
    ["精英减伤", "Elite DMG Reduction"],
    ["物攻", "ATK"],
    ["魔攻", "MATK"],
    ["护甲", "Armor"],
    ["耐力", "Stamina"],
    ["生命", "HP"],
  ];
  for (const [from, to] of replacements) {
    text = text.replaceAll(from, to);
  }
  text = text.replace(/\+/g, " + ");
  text = text.replace(/Lv(\d+)/g, "Lv.$1");
  text = text.replace(/([A-Za-z])Lv\./g, "$1 Lv.");
  text = text.replace(/\s+/g, " ").trim();
  return /^[\x00-\x7F]+$/.test(text) ? text : "";
}

function effectComponentForFoodLabel(label, order) {
  const cleanLabel = String(label || "").replace(/\bLv\.\d+\b/gi, "").trim();
  const key = cleanLabel.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
  if (!cleanLabel || !key) return null;

  if (/^dmg to elites$/i.test(cleanLabel)) {
    return {
      componentKey: key,
      componentOrder: order,
      label: cleanLabel,
      effectClass: "damage-modifier",
      direction: "damage-dealt",
      contributionScope: "targeted",
      targetPredicate: { monsterRankAtLeast: "elite" },
      predicateTags: ["direction.damage-dealt", "target.elite-or-stronger"],
    };
  }

  if (/^elite dmg reduction$/i.test(cleanLabel)) {
    return {
      componentKey: key,
      componentOrder: order,
      label: cleanLabel,
      effectClass: "damage-reduction",
      direction: "damage-taken",
      contributionScope: "incoming",
      attackerPredicate: { monsterRankAtLeast: "elite" },
      predicateTags: ["attacker.elite-or-stronger", "direction.damage-taken-or-defense"],
    };
  }

  const statKinds = new Map([
    ["ATK", "offense-stat"],
    ["MATK", "offense-stat"],
    ["Armor", "defense-stat"],
    ["Stamina", "resource-stat"],
    ["HP", "resource-stat"],
    ["HP Regen", "resource-stat"],
  ]);
  const statKind = statKinds.get(cleanLabel);
  if (statKind) {
    return {
      componentKey: key,
      componentOrder: order,
      label: cleanLabel,
      effectClass: statKind,
      direction: "stat",
      stat: cleanLabel,
      contributionScope: "global",
      predicateTags: ["scope.global"],
    };
  }

  return {
    componentKey: key,
    componentOrder: order,
    label: cleanLabel,
    effectClass: "unknown-effect",
    contributionScope: "unknown",
    predicateTags: ["needs.effect-component-classification"],
  };
}

function parseFoodEffectComponents(effectNameEn) {
  const clean = String(effectNameEn || "").replace(/\bLv\.\d+\b/gi, "").trim();
  if (!clean) return [];
  return clean
    .split(/\s+\+\s+/)
    .map((part, index) => effectComponentForFoodLabel(part, index + 1))
    .filter(Boolean);
}

function foodBuffEffectNames(row) {
  const names = normalizedNames(row.Names, row.Name ?? row.NameDesign ?? row.DesignName ?? "Cuisine");
  const effectName = translateFoodDesignName(row.DesignName ?? row.Names?.design ?? "");
  if (effectName) {
    names.en = `${names.en || "Cuisine"} - ${effectName}`;
  }
  return names;
}

function addConsumableBuffCatalog(builder, buffRows, items, consumableBridge) {
  const itemById = buildItemIdIndex(items);
  const foodBridgeByBuffId = consumableBridge?.foodBuffSourcesByBuffId ?? {};
  for (const row of Array.isArray(buffRows) ? buffRows : Object.values(buffRows ?? {})) {
    const buffId = toNumber(row.Id);
    if (buffId === null) continue;
    const kind = consumableBuffKind(row);
    if (!kind) continue;

    const bridgeSource = kind === "food" ? foodBridgeByBuffId[String(buffId)] : null;
    const itemCandidate = kind === "potion" ? consumableItemCandidate(buffId, kind, itemById) : null;
    const fallbackFoodEffectName = kind === "food"
      ? translateFoodDesignName(row.DesignName ?? row.Names?.design ?? "")
      : "";
    const effectComponents = bridgeSource?.effectComponents
      ?? (fallbackFoodEffectName ? parseFoodEffectComponents(fallbackFoodEffectName) : []);
    const sourceNames = bridgeSource
      ? normalizedNames(bridgeSource.sourceNames, bridgeSource.sourceName ?? row.NameDesign ?? "Cuisine")
      : itemCandidate
      ? normalizedNames(itemCandidate.row.Names, itemCandidate.row.Name ?? itemCandidate.row.NameDesign ?? row.NameDesign)
      : kind === "food"
      ? foodBuffEffectNames(row)
      : normalizedNames(row.Names, row.Name ?? row.NameDesign ?? row.DesignName ?? "Potion");
    builder.upsertSource({
      sourceId: `buff-source:${buffId}`,
      sourceKind: "consumable",
      sourceType: kind === "food" ? "food-buff" : "potion-buff",
      sourceEntityId: buffId,
      sourceName: preferredName(sourceNames, kind === "food" ? "Cuisine" : "Potion"),
      sourceNames,
      descriptionIds: bridgeSource?.descriptionIds,
      description: bridgeSource?.description,
      descriptions: bridgeSource?.descriptions,
      cleanDescriptions: bridgeSource?.cleanDescriptions,
      iconPath: row.IconPath,
      runtimeDetection: "active-buff",
      sourceTable: "BuffName",
      buffIds: [buffId],
      effectComponents,
      evidence: [stripUndefined({
        source: bridgeSource
          ? "ConsumableBuffBridge.food-item-use-table"
          : itemCandidate
          ? "BuffName.itemnames-consumable-id-family"
          : "BuffName.consumable-buff-icon",
        buffSourceId: buffId,
        consumableKind: kind,
        foodBuffBaseIds: bridgeSource?.buffBaseIds,
        foodEffectName: bridgeSource?.effectNameEn,
        foodEffectDesignName: bridgeSource?.effectDesignName,
        foodEffectComponents: effectComponents,
        foodDescriptionIds: bridgeSource?.descriptionIds,
        foodDescription: bridgeSource?.description,
        candidateItemCount: bridgeSource?.candidateItemCount,
        candidateItemIds: bridgeSource?.candidateItemIds,
        candidateItemNames: bridgeSource?.candidateItemNames,
        foodBridgeSelectionMethods: bridgeSource?.selectionMethods,
        itemId: itemCandidate?.itemId,
        itemName: itemCandidate?.row?.Names?.en ?? itemCandidate?.row?.NameDesign,
        itemIconPath: itemCandidate?.row?.IconPath,
        buffName: row.Names?.en ?? row.NameDesign ?? row.Name,
        buffIconPath: row.IconPath,
        buffSourceOffset: row.SourceOffset,
        itemSourceOffset: itemCandidate?.row?.SourceOffset,
        relationshipPolicy: bridgeSource
          ? bridgeSource.relationshipPolicy
          : itemCandidate
          ? "Exact consumable label is used only when itemnames and BuffName share the same final-three-digit id family in the food/potion runtime buff range."
          : "Runtime buff is exposed as a generic food/potion buff because no exact item row was proven from the current game files.",
      })],
    });
  }
}

function addSkillBreakdownLinks(builder, breakdown, ownerIndex) {
  for (const detail of Object.values(breakdown ?? {})) {
    const damageId = toNumber(detail.Id);
    if (damageId === null) continue;
    const parentRecountId = toNumber(detail.ParentRecountId);
    const parentTalentId = toNumber(detail.ParentTalentId);
    const sourceTalentId = toNumber(detail.SourceTalentId);
    const buffSourceId = toNumber(detail.BuffSourceId);

    if (parentTalentId !== null) {
      builder.upsertSource({
        sourceId: `talent:${parentTalentId}`,
        sourceKind: "talent-passive",
        sourceType: "talent",
        sourceEntityId: parentTalentId,
        sourceName: detail.ParentTalentName,
        sourceNames: detail.ParentTalentNames,
        runtimeDetection: "row-observed",
        sourceTable: "SkillBreakdownDetails",
        targets: [
          {
            targetKind: "damage",
            damageId,
            relationshipKind: "produces-damage-row",
            evidenceSource: "SkillBreakdownDetails.ParentTalentId",
            evidenceStatus: "current-production-breakdown-talent-bridge",
            parentRecountId,
            category: detail.Category,
          },
        ],
      });
    }

    if (sourceTalentId !== null) {
      builder.upsertSource({
        sourceId: `talent:${sourceTalentId}`,
        sourceKind: "talent-passive",
        sourceType: "talent",
        sourceEntityId: sourceTalentId,
        sourceName: detail.SourceTalentName,
        sourceNames: detail.SourceTalentNames,
        runtimeDetection: "row-observed",
        sourceTable: "SkillBreakdownDetails",
        targets: [{
          targetKind: "damage",
          damageId,
          relationshipKind: "affects-damage-row",
          evidenceSource: "SkillBreakdownDetails.SourceTalentId",
          evidenceStatus: "current-production-source-talent-bridge",
          parentRecountId,
          sourceTalentBridge: detail.SourceTalentBridge,
          category: detail.Category,
        }],
      });
    }

    if (detail.IsBuffSource && buffSourceId !== null) {
      const sourceNames = buffSourceNamesFromDetail(detail, buffSourceId, ownerIndex);
      const targets = [
        {
          targetKind: "damage",
          damageId,
          relationshipKind: "buff-source-damage-row",
          evidenceSource: "SkillBreakdownDetails.BuffSourceId",
          evidenceStatus: "current-production-buff-source-bridge",
          parentRecountId,
          parentRecountName: detail.ParentRecountName,
          category: detail.Category,
        },
      ];
      if (parentRecountId !== null) {
        targets.push({
          targetKind: "recount",
          recountId: parentRecountId,
          recountName: detail.ParentRecountName,
          relationshipKind: "buff-source-recount-row",
          evidenceSource: "SkillBreakdownDetails.BuffSourceId",
          evidenceStatus: "current-production-buff-source-bridge",
          category: detail.Category,
        });
      }

      builder.upsertSource({
        sourceId: `buff-source:${buffSourceId}`,
        sourceKind: detail.SourceKind ?? detail.Category ?? "buff-source",
        sourceType: detail.SourceType ?? detail.SourceRole ?? "buff-source",
        sourceEntityId: buffSourceId,
        sourceName: preferredName(sourceNames, detail.LinkedName ?? detail.DisplayName ?? detail.DamageName ?? `Buff ${buffSourceId}`),
        sourceNames,
        iconPath: detail.IconPath ?? detail.LinkedBuffIconPath ?? detail.ParentBaseSkillIconPath,
        runtimeDetection: "active-buff",
        sourceTable: "SkillBreakdownDetails",
        buffIds: uniqueNumbers([buffSourceId, detail.LinkedBuffId, detail.LinkedId]),
        targets,
        evidence: [{
          source: "SkillBreakdownDetails",
          buffSourceId,
          linkedSource: detail.LinkedSource,
          linkedId: detail.LinkedId,
          category: detail.Category,
          reason: detail.Reason,
        }],
      });
    }
  }
}

function addTalentProbeCatalog(builder, talentProbe) {
  for (const row of talentProbe?.talentRows ?? []) {
    const talentId = toNumber(row.id);
    if (talentId === null) continue;
    builder.upsertSource({
      sourceId: `talent:${talentId}`,
      sourceKind: "talent-passive",
      sourceType: "talent",
      sourceEntityId: talentId,
      sourceName: row.name,
      sourceNames: row.names,
      iconPath: row.iconPath,
      runtimeDetection: "row-observed-or-active-buff",
      sourceTable: row.sourceTable,
      buffIds: uniqueNumbers((row.buffEffectRecords ?? []).map((record) => record.buffId)),
      descriptions: row.descriptions,
      cleanDescriptions: row.cleanDescriptions,
      modifierEvidence: buildDescriptionModifierEvidence({
        source: row.descriptionSourceTable && row.descriptionSourceTable !== row.sourceTable
          ? "TalentEffectModelProbe.talentRows.buffDescriptionReference"
          : "TalentEffectModelProbe.talentRows",
        valueStatus: "fixed-description-text",
        descriptionId: row.descriptionId,
        cleanDescriptions: row.cleanDescriptions,
      }),
      evidence: [{
        source: "TalentEffectModelProbe.talentRows",
        sourceOffset: row.sourceOffset,
        descriptionId: row.descriptionId,
        descriptionSourceTable: row.descriptionSourceTable,
        descriptionSourceBuffId: row.descriptionSourceBuffId,
        descriptionReferenceRecords: (row.descriptionReferenceRecords ?? []).map((record) => stripUndefined({
          sourceTable: record.sourceTable,
          sourceOffset: record.sourceOffset,
          buffId: record.buffId,
          descriptionId: record.descriptionId,
        })),
      }],
    });
  }
}

function applyTalentOwnershipMetadata(builder, talentOwnership) {
  let applied = 0;
  for (const [talentId, ownership] of Object.entries(talentOwnership?.talentsById ?? {})) {
    const sourceId = `talent:${talentId}`;
    const source = builder.effectSourcesById[sourceId];
    if (!source) continue;
    source.talentOwnership = stripUndefined({
      classId: ownership.classId,
      className: ownership.className,
      classNames: ownership.classNames,
      ownershipKind: ownership.ownershipKind,
      ownershipStatus: ownership.ownershipStatus,
      confidence: ownership.confidence,
      hardFilterEligible: Boolean(ownership.hardFilterEligible),
      specIds: ownership.specIds,
      specNameKeys: ownership.specNameKeys,
      specNames: ownership.specNames,
      dpsRelevance: ownership.dpsRelevance,
      generationSource: "TalentSpecOwnership.gen",
      parserPolicy: {
        selectedTalentEvidenceRequired: true,
        safeToRejectWrongSpec:
          ownership.ownershipKind === "spec-exclusive"
          && ownership.ownershipStatus === "high-confidence"
          && Boolean(ownership.hardFilterEligible),
        keepRuntimeEvidenceForAmbiguousRows: ownership.ownershipKind !== "spec-exclusive",
      },
      evidence: (ownership.evidence ?? []).slice(0, 12),
    });
    source.evidence = mergeEvidence(source.evidence, [{
      source: "TalentSpecOwnership",
      ownershipKind: ownership.ownershipKind,
      ownershipStatus: ownership.ownershipStatus,
      confidence: ownership.confidence,
      specIds: ownership.specIds,
    }]);
    builder.effectSourcesById[sourceId] = stripUndefined(source);
    applied += 1;
  }
  builder.talentOwnershipSummary = stripUndefined({
    source: talentOwnership?.summary?.source,
    talentRows: talentOwnership?.summary?.talentRows,
    specRows: talentOwnership?.summary?.specRows,
    ownershipCounts: talentOwnership?.summary?.ownershipCounts,
    hardFilterEligibleRows: talentOwnership?.summary?.hardFilterEligibleRows,
    dpsRowsNeedingReview: talentOwnership?.summary?.dpsRowsNeedingReview,
    appliedEffectSources: applied,
  });
}

function addClassSpecSharedBuffAliases(builder, classSpecProbe) {
  for (const group of classSpecProbe?.sharedLocalizedNames ?? []) {
    const entities = Array.isArray(group.entities) ? group.entities : [];
    const talentRows = entities
      .filter((entity) => entity?.type === "talent-passive")
      .map((entity) => ({
        ...entity,
        id: toNumber(entity.id),
      }))
      .filter((entity) => entity.id !== null);
    const buffIds = uniqueNumbers(
      entities
        .filter((entity) => entity?.type === "buff")
        .map((entity) => entity.id),
    );
    if (talentRows.length === 0 || buffIds.length === 0) continue;

    for (const talent of talentRows) {
      const sourceId = `talent:${talent.id}`;
      const existing = builder.effectSourcesById[sourceId];
      if (!existing) continue;
      const aliasBuffIds = buffIds.filter((buffId) => !(existing.buffIds ?? []).includes(buffId));
      if (aliasBuffIds.length === 0) continue;
      builder.upsertSource({
        sourceId,
        sourceKind: existing.sourceKind ?? "talent-passive",
        sourceType: existing.sourceType ?? "talent",
        sourceEntityId: talent.id,
        sourceName: existing.sourceName ?? talent.name,
        sourceNames: talent.names,
        iconPath: existing.iconPath ?? talent.iconPath,
        runtimeDetection: existing.runtimeDetection ?? "row-observed-or-active-buff",
        sourceTable: "ClassSpecSkillModelProbe.sharedLocalizedNames",
        buffIds: aliasBuffIds,
        evidence: [stripUndefined({
          source: "ClassSpecSkillModelProbe.sharedLocalizedNames",
          nameKey: group.nameKey,
          displayName: group.displayName,
          linkedBuffIds: aliasBuffIds,
          relationshipPolicy:
            "Exact localized name groups are used as runtime buff aliases only; they do not imply a damage formula.",
        })],
      });
    }
  }
}

function buildClassSpecActivationTriggers(builder, classSpecProbe) {
  const triggers = [];
  for (const group of classSpecProbe?.sharedLocalizedNames ?? []) {
    const entities = Array.isArray(group.entities) ? group.entities : [];
    const baseSkills = entities
      .filter((entity) => entity?.type === "base-skill")
      .map((entity) => ({ ...entity, id: toNumber(entity.id) }))
      .filter((entity) => entity.id !== null);
    const buffIds = uniqueNumbers(
      entities
        .filter((entity) => entity?.type === "buff")
        .map((entity) => entity.id),
    ).filter((buffId) => sourceHasBuffIndex(builder, buffId));
    if (baseSkills.length === 0 || buffIds.length === 0) continue;

    let names = normalizedNames(group.names, group.displayName ?? group.nameKey);
    for (const entity of [...baseSkills, ...entities.filter((entry) => entry?.type === "buff")]) {
      names = mergeNameMaps(names, entityNames(entity, group.displayName ?? group.nameKey));
    }
    const englishName = normalizeActivationText(localeText(names, "en") || group.displayName || group.nameKey);
    if (ACTIVATION_TRIGGER_STOPWORDS.has(englishName)) continue;

    triggers.push({
      nameKey: group.nameKey,
      displayName: group.displayName ?? preferredName(names, group.nameKey),
      names,
      baseSkillIds: uniqueNumbers(baseSkills.map((entity) => entity.id)),
      buffIds,
    });
  }
  return triggers;
}

function descriptionActivationMatch(row, trigger) {
  const matchedLocales = [];
  for (const locale of LOCALES) {
    const triggerText = normalizeActivationText(localeText(trigger.names, locale));
    if (triggerText.length < 4) continue;
    const descriptionText = normalizeActivationText([
      localeText(row.cleanDescriptions, locale),
      localeText(row.descriptions, locale),
      localeText(row.descriptionLinkTexts, locale),
    ].filter(Boolean).join(" "));
    if (!descriptionText.includes(triggerText)) continue;
    if (!ACTIVATION_DESCRIPTION_MARKERS.some((marker) => marker.test(descriptionText))) continue;
    matchedLocales.push(locale);
  }
  if (matchedLocales.length === 0) return null;
  return {
    matchKind: "description-activation-phrase",
    matchedLocales,
  };
}

function nameStemActivationMatch(row, trigger) {
  const triggerText = normalizeActivationText(localeText(trigger.names, "en"));
  const sourceText = normalizeActivationText(localeText(row.names, "en") || row.name);
  if (triggerText.length < 4 || sourceText.length < 4) return null;
  if (sourceText === triggerText) return null;
  if (!sourceText.startsWith(triggerText)) return null;
  return {
    matchKind: "name-stem-prefix",
    matchedLocales: ["en"],
  };
}

function findActivationAliasMatch(row, trigger) {
  return descriptionActivationMatch(row, trigger) ?? nameStemActivationMatch(row, trigger);
}

function triggerSourceIdsForActivationAlias(builder, trigger) {
  return uniqueStrings(
    trigger.buffIds.flatMap((buffId) => builder.buffIdToEffectSourceIds[String(buffId)] ?? []),
  ).filter((sourceId) => sourceId.startsWith("buff-source:"));
}

function addClassSpecActivationAliases(builder, classSpecProbe, talentProbe) {
  const triggers = buildClassSpecActivationTriggers(builder, classSpecProbe);
  if (triggers.length === 0) return;

  for (const row of talentProbe?.talentRows ?? []) {
    const talentId = toNumber(row.id);
    if (talentId === null) continue;
    const sourceId = `talent:${talentId}`;
    const existing = builder.effectSourcesById[sourceId];
    if (!existing) continue;

    for (const trigger of triggers) {
      const existingBuffIds = uniqueNumbers(existing.buffIds ?? []);
      const aliasBuffIds = trigger.buffIds
        .filter((buffId) => !existingBuffIds.includes(buffId));
      if (aliasBuffIds.length === 0) continue;
      const match = findActivationAliasMatch(row, trigger);
      if (!match) continue;

      builder.upsertSource({
        sourceId,
        sourceKind: existing.sourceKind ?? "talent-passive",
        sourceType: existing.sourceType ?? "talent",
        sourceEntityId: talentId,
        sourceName: existing.sourceName ?? row.name,
        sourceNames: existing.sourceNames ?? row.names,
        iconPath: existing.iconPath ?? row.iconPath,
        runtimeDetection: existing.runtimeDetection ?? "row-observed-or-active-buff",
        sourceTable: "ClassSpecSkillModelProbe.sharedLocalizedNames",
        buffIds: aliasBuffIds,
        evidence: [stripUndefined({
          source: "ClassSpecSkillModelProbe.sharedLocalizedNames.activationAlias",
          matchKind: match.matchKind,
          matchedLocales: match.matchedLocales,
          triggerNameKey: trigger.nameKey,
          triggerDisplayName: trigger.displayName,
          triggerBaseSkillIds: trigger.baseSkillIds,
          linkedBuffIds: aliasBuffIds,
          talentId,
          talentName: existing.sourceName ?? row.name,
          relationshipPolicy:
            "Activation aliases map a talent/passive source row to the runtime buff window that enables it. They only expose uptime; they do not imply a damage formula.",
        })],
      });

      const childBuffIds = existingBuffIds.filter((buffId) => !trigger.buffIds.includes(buffId));
      if (childBuffIds.length > 0) {
        for (const triggerSourceId of triggerSourceIdsForActivationAlias(builder, trigger)) {
          const triggerSource = builder.effectSourcesById[triggerSourceId];
          builder.upsertSource({
            sourceId: triggerSourceId,
            sourceKind: triggerSource?.sourceKind ?? "buff-source",
            sourceType: triggerSource?.sourceType ?? "activation-buff",
            sourceEntityId: triggerSource?.sourceEntityId,
            sourceName: triggerSource?.sourceName ?? trigger.displayName,
            sourceNames: triggerSource?.sourceNames ?? trigger.names,
            iconPath: triggerSource?.iconPath,
            runtimeDetection: triggerSource?.runtimeDetection ?? "active-buff",
            sourceTable: "ClassSpecSkillModelProbe.sharedLocalizedNames",
            buffIds: childBuffIds,
            evidence: [stripUndefined({
              source: "ClassSpecSkillModelProbe.sharedLocalizedNames.activationTriggerAlias",
              matchKind: match.matchKind,
              matchedLocales: match.matchedLocales,
              triggerNameKey: trigger.nameKey,
              triggerDisplayName: trigger.displayName,
              triggerBuffIds: trigger.buffIds,
              linkedChildBuffIds: childBuffIds,
              talentId,
              talentName: existing.sourceName ?? row.name,
              relationshipPolicy:
                "If a child talent/passive buff is observed, the parent activation buff can also be treated as active for uptime reporting. This exposes the activation window only; it does not imply formula semantics.",
            })],
          });
        }
      }
    }
  }
}

function addSeasonTalentNodes(builder, seasonTalentProbe) {
  builder.addDescriptionTargetSources((row) => {
    const nodeId = toNumber(row.id);
    if (nodeId === null) return null;
    return {
      sourceId: `season-talent-node:${nodeId}`,
      sourceKind: "season-talent-node",
      sourceType: "deep-slumber-mind-projection-node",
      sourceEntityId: nodeId,
      sourceName: row.name,
      sourceNames: row.names,
      iconPath: row.alignedBuff?.iconPath,
      runtimeDetection: "active-buff",
      sourceTable: row.sourceTable,
      buffIds: uniqueNumbers([
        row.alignedBuffId,
        row.computedAlignedBuffId,
        ...(row.buffEffectRecords ?? []).map((record) => record.buffId),
      ]),
      descriptions: row.descriptionCandidates?.[0]?.texts,
      cleanDescriptions: row.descriptionCandidates?.[0]?.cleanTexts,
      modifierEvidence: buildDescriptionModifierEvidence({
        source: "SeasonTalentNodeProbe.descriptionCandidates",
        valueStatus: "fixed-description-text",
        descriptionId: row.descriptionCandidates?.[0]?.descriptionId,
        cleanDescriptions: row.descriptionCandidates?.[0]?.cleanTexts,
      }),
      evidence: [{
        source: "SeasonTalentNodeProbe.nodeRows",
        groupIndex: row.groupIndex,
        slotIndex: row.slotIndex,
        alignedBuffBridge: row.alignedBuffBridge,
      }],
    };
  }, (seasonTalentProbe?.nodeRows ?? []).map((row) => ({
    ...row,
    descriptionId: row.descriptionCandidates?.[0]?.descriptionId,
    cleanDescriptions: row.descriptionCandidates?.[0]?.cleanTexts,
    descriptionSourceTable: seasonTalentProbe?.summary?.descriptionSourceTable,
  })));
}

function addSeasonRogueEntries(builder, seasonRogueProbe) {
  builder.addDescriptionTargetSources((row) => {
    const entryId = toNumber(row.entryId);
    if (entryId === null) return null;
    return {
      sourceId: `season-rogue-entry:${entryId}`,
      sourceKind: "season-rogue-entry",
      sourceType: row.entryFamily,
      sourceEntityId: entryId,
      sourceName: row.name,
      sourceNames: row.names,
      iconPath: row.textureIconPath,
      runtimeDetection: "active-buff",
      sourceTable: row.sourceTable,
      buffIds: uniqueNumbers([row.buffId]),
      descriptions: row.descriptions,
      cleanDescriptions: row.cleanDescriptions,
      modifierEvidence: buildDescriptionModifierEvidence({
        source: "SeasonRogueEntryProbe.entries",
        valueStatus: "fixed-description-text",
        descriptionId: row.descriptionId,
        cleanDescriptions: row.cleanDescriptions,
      }),
      evidence: [{
        source: "SeasonRogueEntryProbe.entries",
        difficultyAvailability: row.difficultyAvailability,
        buffIdStatus: row.buffIdStatus,
      }],
    };
  }, (seasonRogueProbe?.entries ?? []).map((row) => ({
    ...row,
    descriptionSourceTable: seasonRogueProbe?.summary?.descriptionSourceTable,
  })));
}

function matchDescriptionTargets(cleanDescriptions, nameIndex, recountRows) {
  const byRecountId = new Map();
  for (const localeId of LOCALES) {
    const text = cleanDescriptions?.[localeId];
    if (!text) continue;
    for (const mention of extractDreamTargets(text, localeId)) {
      for (const candidateText of expandTargetLabels(mention.targetText)) {
        const match = matchLabel(candidateText, localeId, nameIndex, recountRows);
        if (match.rows.length !== 1) continue;
        const row = match.rows[0];
        byRecountId.set(String(row.recountId), {
          recountId: row.recountId,
          recountName: row.recountName,
          localeId,
          targetText: mention.targetText,
          candidateText,
          matchedText: match.matchedText,
          evidenceStatus: match.evidenceStatus,
        });
      }
    }
  }
  return [...byRecountId.values()].sort((left, right) => left.recountId - right.recountId);
}

function extractDreamTargets(text, localeId) {
  const cleanText = cleanMarkup(text);
  const targets = [];
  for (const regex of DREAM_MARKERS) {
    regex.lastIndex = 0;
    for (const match of cleanText.matchAll(regex)) {
      const markerStart = match.index ?? 0;
      const markerEnd = markerStart + match[0].length;
      const beforeTarget = cleanupTargetText(lastClause(cleanText.slice(0, markerStart)));
      const afterTarget = cleanupTargetText(
        firstClause(cleanText.slice(markerEnd).replace(/^\s*(?:of|from|dari|de|da|do|du|del|von|des|\u7684|\u306e|\uc758|\u0e02\u0e2d\u0e07)\s+/i, "")),
      );
      const targetText = afterTarget && (!beforeTarget || /^(?:the|a|an)$/i.test(beforeTarget))
        ? afterTarget
        : beforeTarget;
      if (!targetText || isDefensiveText(targetText) || isDefensiveText(cleanText.slice(markerEnd))) {
        continue;
      }
      targets.push({ localeId, targetText });
    }
  }
  return dedupeBy(targets, (entry) => `${entry.localeId}|${entry.targetText}`);
}

function lastClause(value) {
  return splitTopLevel(value, /[.;\u3002\uff1b]/).at(-1) ?? "";
}

function firstClause(value) {
  return splitTopLevel(value, /[.;\u3002\uff1b+]/)[0] ?? "";
}

function splitTopLevel(value, delimiterRegex) {
  const parts = [];
  let current = "";
  let depth = 0;
  for (const char of String(value || "")) {
    if (char === "(" || char === "\uff08") depth += 1;
    else if ((char === ")" || char === "\uff09") && depth > 0) depth -= 1;
    if (depth === 0 && delimiterRegex.test(char)) {
      parts.push(current);
      current = "";
      delimiterRegex.lastIndex = 0;
      continue;
    }
    current += char;
    delimiterRegex.lastIndex = 0;
  }
  parts.push(current);
  return parts;
}

function cleanupTargetText(value) {
  return cleanMarkup(value)
    .replace(/^.*(?:\bafter\b|\bduring\b|\bwhen\b|\bwhile\b)[^,]*,\s*/i, "")
    .replace(/\([^)]*(?:does not affect|unchanged)[^)]*\)/gi, "")
    .replace(/(?:\u306e|\uc758|\u7684)$/g, "")
    .replace(/^(?:and|or|of|from|de|da|do|du|del|von|dari|the|les|le|la|der|die|das|el|los|las|o|os|as)\s+/i, "")
    .replace(/\s*(?:\+|increases(?: by)?|is increased(?: by)?|are increased(?: by)?|increased from|wird um erh\u00f6ht|aumenta(?: em)?|aumentado(?: en)?|เพิ่ม|증가합니다).*$/i, "")
    .replace(/[:：,，;；.。]+$/g, "")
    .trim();
}

function expandTargetLabels(value) {
  const out = new Set();
  const cleaned = cleanupTargetText(value);
  if (!cleaned) return [];
  out.add(cleaned);
  for (const grouped of expandGroupedLabels(cleaned)) out.add(grouped);
  for (const part of splitConjoined(cleaned)) out.add(part);
  return [...out]
    .map(cleanupTargetText)
    .filter((entry) => entry && !isGenericLabel(entry))
    .sort((left, right) => right.length - left.length || left.localeCompare(right));
}

function expandGroupedLabels(value) {
  const out = [];
  for (const match of String(value || "").matchAll(/([^\(\uff08]{1,48})[\(\uff08]([^\)\uff09]+)[\)\uff09]/g)) {
    const prefix = cleanupTargetText(match[1]).replace(/^.*[\s,，、]/, "").trim();
    for (const part of splitConjoined(match[2])) {
      out.push(part);
      if (prefix && !normalizeLabel(part).startsWith(normalizeLabel(prefix))) {
        out.push(/^[A-Za-z0-9]/.test(prefix) && /^[A-Za-z0-9]/.test(part)
          ? `${prefix} ${part}`
          : `${prefix}${part}`);
      }
    }
  }
  return out;
}

function splitConjoined(value) {
  return splitTopLevel(value, /[,，、/]/)
    .flatMap((part) => part.split(/\s+(?:and|or|und|et|y|e|dan)\s+/i))
    .map(cleanupTargetText)
    .filter(Boolean);
}

function matchLabel(label, localeId, nameIndex, recountRows) {
  const normalized = normalizeLabel(label);
  if (!normalized || isGenericLabel(label)) return { rows: [] };
  const exact = uniqueRows(nameIndex.get(`${localeId}|${normalized}`) ?? []);
  if (exact.length) {
    return {
      rows: exact,
      matchedText: label,
      evidenceStatus: "description-target-exact-localized-name",
    };
  }
  const suffix = uniqueRows(recountRows.filter((row) => {
    const name = normalizeLabel(row.recountNames?.[localeId]);
    return isSafeSuffix(normalized, name);
  }));
  return suffix.length === 1
    ? {
      rows: suffix,
      matchedText: label,
      evidenceStatus: "description-target-unique-localized-suffix",
    }
    : { rows: [] };
}

function isSafeSuffix(target, name) {
  if (!target || !name || target === name || !name.endsWith(target)) return false;
  return /^[a-z0-9 ]+$/.test(target)
    ? target.length >= 8 && target.includes(" ")
    : target.length >= 4;
}

function isGenericLabel(value) {
  const normalized = normalizeLabel(value);
  return normalized.length < 3
    || new Set([
      "dream dmg",
      "dreamscape dmg",
      "class skill",
      "ultimate",
      "lucky strike",
      "basic attack",
      "normal attack",
      "\u666e\u901a\u653b\u51fb",
      "\u666e\u901a\u653b\u64ca",
      "\u901a\u5e38\u653b\u6483",
      "\uc77c\ubc18 \uacf5\uaca9",
      "ataque b\u00e1sico",
    ]).has(normalized);
}

function isDefensiveText(value) {
  return /(?:Resistance|Reduction|Resist|Mitigation|Taken|DEF|Reducci|R\u00e9duction|Redu\u00e7|Resist\u00eancia|\u51cf\u514d|\u6e1b\u514d|\u62b5\u6297|\u6297\u6027|\u8efd\u6e1b|\uac10\uba74|\uac10\uc18c|\uc800\ud56d)/i
    .test(String(value || ""));
}

function normalizeLabel(value) {
  return cleanMarkup(value)
    .replace(/[\u200b-\u200f\ufeff]/g, "")
    .replace(/\s+/g, " ")
    .trim()
    .toLowerCase();
}

function uniqueRows(rows) {
  const byId = new Map();
  for (const row of rows ?? []) {
    byId.set(String(row.recountId), row);
  }
  return [...byId.values()].sort((left, right) => left.recountId - right.recountId);
}

function dedupeBy(values, keyFn) {
  const seen = new Set();
  const out = [];
  for (const value of values ?? []) {
    const key = keyFn(value);
    if (seen.has(key)) continue;
    seen.add(key);
    out.push(value);
  }
  return out;
}

function main() {
  const args = parseArgs(process.argv.slice(2));
  if (args.help) {
    printHelp();
    return;
  }

  const factorData = readJson(args.factors, {});
  const breakdown = readJson(args.breakdown, {});
  const recount = readJson(args.recount, {});
  const buffs = readJson(args.buffs, []);
  const items = readJson(args.items, []);
  const monsters = readJson(args.monsters, {});
  const aoyiSkills = readJson(args.aoyiSkills, []);
  const consumableBridge = readJson(args.consumableBridge, {});
  const talentProbe = readJson(args.talentProbe, {});
  const classSpecProbe = readJson(args.classSpecProbe, {});
  const talentOwnership = readJson(args.talentOwnership, {});
  const seasonTalentProbe = readJson(args.seasonTalentProbe, {});
  const seasonRogueProbe = readJson(args.seasonRogueProbe, {});
  const linkTextDescriptions = readJson(args.linkTexts, {});
  const recountRows = collectRecountRows(recount);
  const imagineOwnerIndex = buildImagineOwnerIndex(items, monsters, aoyiSkills);
  const battleImagineSourceConfigOwnerRules = buildBattleImagineSourceConfigOwnerRules(buffs, imagineOwnerIndex);

  const builder = new EffectSourceBuilder(recountRows);
  addPhantomFactors(builder, factorData);
  addTalentProbeCatalog(builder, talentProbe);
  addClassSpecSharedBuffAliases(builder, classSpecProbe);
  addRecountTalentLinks(builder, recountRows);
  addImagineBuffCatalog(builder, buffs, imagineOwnerIndex, battleImagineSourceConfigOwnerRules);
  addRecountMatchedBuffCatalog(builder, buffs);
  addDesignOnlyRuntimeBuffCatalog(builder, buffs, imagineOwnerIndex);
  addConsumableBuffCatalog(builder, buffs, items, consumableBridge);
  addSkillBreakdownLinks(builder, breakdown, imagineOwnerIndex);
  addClassSpecActivationAliases(builder, classSpecProbe, talentProbe);
  addSeasonTalentNodes(builder, seasonTalentProbe);
  addSeasonRogueEntries(builder, seasonRogueProbe);
  postProcessDesignOnlyBuffSources(builder);
  enrichSourcesWithLinkedTooltips(builder, linkTextDescriptions);
  applyTalentOwnershipMetadata(builder, talentOwnership);
  addFormulaAttributionLayer(builder);

  const effectSourceIds = Object.keys(builder.effectSourcesById).sort((a, b) => a.localeCompare(b));
  const data = {
    summary: {
      source: "EffectSources.gen",
      generatedFrom: {
        factors: path.relative(repoRoot, args.factors).replaceAll("\\", "/"),
        breakdown: path.relative(repoRoot, args.breakdown).replaceAll("\\", "/"),
        recount: path.relative(repoRoot, args.recount).replaceAll("\\", "/"),
        buffs: path.relative(repoRoot, args.buffs).replaceAll("\\", "/"),
        items: path.relative(repoRoot, args.items).replaceAll("\\", "/"),
        monsters: path.relative(repoRoot, args.monsters).replaceAll("\\", "/"),
        aoyiSkills: path.relative(repoRoot, args.aoyiSkills).replaceAll("\\", "/"),
        consumableBridge: path.relative(repoRoot, args.consumableBridge).replaceAll("\\", "/"),
        talentProbe: path.relative(repoRoot, args.talentProbe).replaceAll("\\", "/"),
        classSpecProbe: path.relative(repoRoot, args.classSpecProbe).replaceAll("\\", "/"),
        talentOwnership: path.relative(repoRoot, args.talentOwnership).replaceAll("\\", "/"),
        seasonTalentProbe: path.relative(repoRoot, args.seasonTalentProbe).replaceAll("\\", "/"),
        seasonRogueProbe: path.relative(repoRoot, args.seasonRogueProbe).replaceAll("\\", "/"),
        linkTexts: path.relative(repoRoot, args.linkTexts).replaceAll("\\", "/"),
      },
      battleImagineOwnerNames: imagineOwnerIndex.battleImagineRecords,
      battleImagineSkillOwnerNames: imagineOwnerIndex.battleImagineSkillRecords,
      battleImagineSourceConfigOwnerRules: battleImagineSourceConfigOwnerRules.size,
      monsterOwnerNameFallbacks: imagineOwnerIndex.monsterFallbackRecords,
      effectSources: effectSourceIds.length,
      consumableBuffSources: effectSourceIds.filter((id) =>
        builder.effectSourcesById[id]?.sourceKind === "consumable",
      ).length,
      foodConsumableBridgeMappedSources: Object.keys(consumableBridge?.foodBuffSourcesByBuffId ?? {}).length,
      activeBuffDetectableSources: effectSourceIds.filter((id) =>
        builder.effectSourcesById[id]?.runtimeDetection?.includes("active-buff")
        && builder.effectSourcesById[id]?.buffIds?.length,
      ).length,
      buffIds: Object.keys(builder.buffIdToEffectSourceIds).length,
      battleImagineSourceConfigLinkedBuffs: effectSourceIds.filter((id) =>
        (builder.effectSourcesById[id]?.evidence ?? []).some((entry) => entry?.sourceConfigId),
      ).length,
      recountRowsWithEffectSources: Object.keys(builder.recountIdToEffectSourceIds).length,
      damageRowsWithEffectSources: Object.keys(builder.damageIdToEffectSourceIds).length,
      sourcesWithModifierEvidence: effectSourceIds.filter((id) =>
        builder.effectSourcesById[id]?.modifierEvidence,
      ).length,
      sourcesWithAttributionModel: effectSourceIds.filter((id) =>
        builder.effectSourcesById[id]?.attributionModel,
      ).length,
      attributionStatuses: countAttributionStatuses(builder.effectSourcesById, effectSourceIds),
      talentOwnership: builder.talentOwnershipSummary,
      designOnlyBuffSourcePostProcess: builder.postProcessSummary,
      linkTextTooltips: builder.linkTextTooltipSummary,
      relationshipPolicy:
        "This file is an evidence index. It exposes affected-by/produced-by relationships and formula-attribution candidates only. Observed damage is overlap evidence until formula replay validates source removal against captured runtime stats and predicates.",
    },
    effectSourceIds,
    effectSourcesById: Object.fromEntries(
      effectSourceIds.map((id) => [id, builder.effectSourcesById[id]]),
    ),
    buffIdToEffectSourceIds: sortIndex(builder.buffIdToEffectSourceIds),
    damageIdToEffectSourceIds: sortIndex(builder.damageIdToEffectSourceIds),
    recountIdToEffectSourceIds: sortIndex(builder.recountIdToEffectSourceIds),
  };

  if (!args.dryRun) {
    fs.mkdirSync(path.dirname(args.out), { recursive: true });
    fs.writeFileSync(args.out, `${JSON.stringify(data, null, 2)}\n`, "utf8");
  }
  console.log(
    `${args.dryRun ? "Dry run: would write" : "Wrote"} ${path.relative(repoRoot, args.out)} (${data.summary.effectSources} sources, ${data.summary.recountRowsWithEffectSources} recount rows, ${data.summary.damageRowsWithEffectSources} damage rows).`,
  );
}

function sortIndex(index) {
  return Object.fromEntries(
    Object.entries(index)
      .sort(([left], [right]) => Number(left) - Number(right))
      .map(([key, value]) => [key, uniqueStrings(value)]),
  );
}

main();
