];

const OBSERVED_ONLY_OFFENSIVE_PATTERNS = [
  /\b(?:damage|dmg|atk|crit|luck|elemental)\b/iu,
  /\u589e\u4f24/u,
  /\u52a0\u653b/u,
  /\u653b\u51fb/u,
  /\u7269\u653b/u,
  /\u66b4\u51fb/u,
  /\u5fc5\u7206/u,
  /\u5e78\u8fd0/u,
  /\u5c5e\u6027/u,
];

function buffRowNames(row) {
  return sortedStrings([
    row?.Name,
    row?.NameDesign,
    row?.DesignName,
    ...Object.values(row?.Names || {}),
  ]);
}

function buffRowDescriptions(row) {
  return sortedStrings([
    row?.Desc,
    row?.Description,
    ...Object.values(row?.Descs || {}),
    ...Object.values(row?.Descriptions || {}),
  ]);
}

function buffRowEvidenceText(row) {
  return [...buffRowNames(row), ...buffRowDescriptions(row)].join("\n");
}

function matchesAnyPattern(text, patterns) {
  return patterns.some((pattern) => pattern.test(text));
}

function isObservedOnlyIgnoredBuffName(row) {
  const text = buffRowNames(row).join("\n");
  return matchesAnyPattern(text, OBSERVED_ONLY_IGNORE_NAME_PATTERNS);
}

function addObservedOnlyIgnoredBuffIds(buffRows, sourceIndex, ignoredBuffIds) {
  let added = 0;
  for (const row of buffRows || []) {
    const id = toPositiveNumber(row?.Id ?? row?.id);
    if (id === null) continue;
    if ((sourceIndex.byBuffId?.[String(id)] || []).length > 0) continue;
    if (!isObservedOnlyIgnoredBuffName(row)) continue;
    if (!ignoredBuffIds.has(id)) {
      ignoredBuffIds.add(id);
      added += 1;
    }
  }
  return added;
}

function observedOnlySourceType(row) {
  const text = buffRowEvidenceText(row);
  if (matchesAnyPattern(text, OBSERVED_ONLY_HEALING_PATTERNS)) return "observed-healing-buff";
  if (matchesAnyPattern(text, OBSERVED_ONLY_DEFENSIVE_PATTERNS)) return "observed-defensive-buff";
  if (matchesAnyPattern(text, OBSERVED_ONLY_TIMING_PATTERNS)) return "observed-timing-buff";
  if (matchesAnyPattern(text, OBSERVED_ONLY_STATE_PATTERNS)) return "observed-state-buff";
  if (matchesAnyPattern(text, OBSERVED_ONLY_OFFENSIVE_PATTERNS)) return "observed-offensive-buff";
  return "observed-buff";
}

function isObservedOnlySourceCandidate(row) {
  const text = buffRowEvidenceText(row);
  if (!text.trim()) return false;
  if (buffRowDescriptions(row).length > 0) return true;
  if (matchesAnyPattern(text, OBSERVED_ONLY_SOURCE_HINT_PATTERNS)) return true;
  return buffRowNames(row).length > 0;
}

function observedOnlyBuffSourceEntry(row, buffId) {
  const sourceType = observedOnlySourceType(row);
  const category = sourceType.includes("offensive")
    ? "offensive"
    : sourceType.includes("defensive")
      ? "defensive"
      : "supportive";
  return {
    sourceId: `observed-buff:${buffId}`,
    sourceKind: "runtime-buff",
    sourceType,
    sourceEntityId: buffId,
    runtimeDetection: "active-buff",
    buffIds: [buffId],
    evidence: [`observed-only-buffname:${buffId}`],
    reportPolicy: "debug-only",
    rowPolicy: "debug",
    sourceCategory: category,
    contributionStatus: "observed-only",
    contributionGroups: [],
    predicateTags: [
      "evidence.observed-buff-window",
      `observed-only.${sourceType}`,
    ],
    providerAggregation: "source-uid",
    uidEdges: [{
      edgeKind: "observed-buff",
      uidKind: "buff",
      uid: buffId,
      role: "runtime",
      source: "ModifierRecountTable.observed-only-buffname",
      status: "debug-only",
    }],
  };
}

function relationshipEdgeStats(relationshipsByRuleId) {
  const uidEdgeKindCounts = {};
  const uidEdgeRoleCounts = {};
  let uidEdges = 0;
  for (const source of Object.values(relationshipsByRuleId)) {
    for (const edge of source.uidEdges || []) {
      uidEdges += 1;
      uidEdgeKindCounts[edge.edgeKind] = (uidEdgeKindCounts[edge.edgeKind] || 0) + 1;
      uidEdgeRoleCounts[edge.role || "unknown"] = (uidEdgeRoleCounts[edge.role || "unknown"] || 0) + 1;
    }
  }
  return {
    sourceRules: Object.keys(relationshipsByRuleId).length,
    uidEdges,
    uidEdgeKindCounts,
    uidEdgeRoleCounts,
  };
}

function isTalentRecountEntry(entry) {
  const sourceId = String(entry?.sourceId || "").toLowerCase();
  return sourceId.startsWith("talent:");
}

function talentOwnershipStats(sourcesById) {
  const ownershipKindCounts = {};
  const ownershipStatusCounts = {};
  const missingRuleIds = [];
  let talentSourceRules = 0;
  let withOwnership = 0;
  let missingOwnership = 0;
  let hardFilterEligible = 0;
  for (const [ruleId, entry] of Object.entries(sourcesById)) {
    if (!isTalentRecountEntry(entry)) continue;
    talentSourceRules += 1;
    if (!entry.talentOwnership) {
      missingOwnership += 1;
      if (missingRuleIds.length < 50) missingRuleIds.push(ruleId);
      continue;
    }
    withOwnership += 1;
    if (entry.talentOwnership.hardFilterEligible === true) hardFilterEligible += 1;
    const kind = entry.talentOwnership.ownershipKind || "unknown";
    const status = entry.talentOwnership.ownershipStatus || "unknown";
    ownershipKindCounts[kind] = (ownershipKindCounts[kind] || 0) + 1;
    ownershipStatusCounts[status] = (ownershipStatusCounts[status] || 0) + 1;
  }
  return {
    talentSourceRules,
    withOwnership,
    missingOwnership,
    hardFilterEligible,
    ownershipKindCounts,
    ownershipStatusCounts,
    missingRuleIds,
  };
}

function recountIdentity(entry, targetDamageIds, source) {
  return {
    source,
    sourceId: entry.sourceId,
    sourceKind: entry.sourceKind,
    sourceType: entry.sourceType,
    sourceEntityId: entry.sourceEntityId,
    runtimeDetection: entry.runtimeDetection,
    buffIds: entry.buffIds,
    targetDamageIds,
    targetRecountIds: entry.targetRecountIds,
    rowPolicy: entry.rowPolicy,
    providerAggregation: entry.providerAggregation,
  };
}

function buildRecountTable(sourceIndex, observedBridge, buffRows, recountTable, formulaZoneContract) {
  const recountDamageIdsById = recountDamageIdsByRecountId(recountTable);
  const sourcesById = {};
  const relationshipsByRuleId = {};
  const byBuffId = {};
  const byFormulaZoneId = {};
  const reportableBuffIds = new Set();
  const debugBuffIds = new Set();
  const ignoredBuffIds = new Set(sortedNumbers(sourceIndex.ignoredBuffIds));
  const policyCounts = {};
  const sourceIndexPolicyCounts = {};
  const reportReasonCounts = {};
  const rowPolicyCounts = {};
  const observedBridgeStats = {
    promotedSources: 0,
    aliasBuffIds: 0,
    aliasRefs: 0,
    ignoredBuffIds: 0,
  };

  function addRecountEntry(buffId, rawEntry, source) {
    const hashTargetDamageIds = sortedNumbers(rawEntry?.targetDamageIds);
    const entry = compactEntry(rawEntry || {}, recountDamageIdsById, formulaZoneContract);
    const sourceIndexPolicy = entry.reportPolicy || "include";
    const effective = effectiveReportPolicy(entry);
    entry.sourceIndexReportPolicy = sourceIndexPolicy;
    entry.reportPolicy = effective.policy;
    entry.runtimeReportReason = effective.reason;
    const policy = entry.reportPolicy;
    const rowPolicy = entry.rowPolicy || "unknown";
    sourceIndexPolicyCounts[sourceIndexPolicy] = (sourceIndexPolicyCounts[sourceIndexPolicy] || 0) + 1;
    policyCounts[policy] = (policyCounts[policy] || 0) + 1;
    reportReasonCounts[effective.reason] = (reportReasonCounts[effective.reason] || 0) + 1;
    rowPolicyCounts[rowPolicy] = (rowPolicyCounts[rowPolicy] || 0) + 1;
    if (policy === "ignore") {
      ignoredBuffIds.add(buffId);
    } else if (policy === "debug-only") {
      debugBuffIds.add(buffId);
      if (isRuntimeWindowTransportEntry(entry)) {
        reportableBuffIds.add(buffId);
      }
    } else {
      reportableBuffIds.add(buffId);
    }

    const entryId = `mrs:${hashEntry(recountIdentity(entry, hashTargetDamageIds, source))}`;
    if (!relationshipsByRuleId[entryId]) {
      relationshipsByRuleId[entryId] = stripUndefined({
        sourceId: entry.sourceId,
        talentOwnership: entry.talentOwnership,
        uidEdges: entry.uidEdges,
      });
    }
    const recountEntry = { ...entry };
    delete recountEntry.uidEdges;
    sourcesById[entryId] ||= recountEntry;
    if (source === "observed-bridge") observedBridgeStats.promotedSources += 1;
    return entryId;
  }

  function addRefsForBuff(buffId, entryIds) {
    if (entryIds.length === 0) return 0;
    const key = String(buffId);
    const before = byBuffId[key]?.length || 0;
    byBuffId[key] = [...new Set([...(byBuffId[key] || []), ...entryIds])].sort();
    return byBuffId[key].length - before;
  }

  for (const [buffIdText, rawEntries] of Object.entries(sourceIndex.byBuffId || {})) {
    const buffId = toPositiveNumber(buffIdText);
    if (buffId === null) continue;
    const entryIds = [];
    for (const rawEntry of rawEntries || []) {
      entryIds.push(addRecountEntry(buffId, rawEntry, "source-index"));
    }
    addRefsForBuff(buffId, entryIds);
  }

  for (const [buffIdText, rawEntries] of Object.entries(observedBridge?.promotedSourcesByBuffId || {})) {
    const buffId = toPositiveNumber(buffIdText);
    if (buffId === null) continue;
    const entryIds = [];
    for (const rawEntry of rawEntries || []) {
      entryIds.push(addRecountEntry(buffId, rawEntry, "observed-bridge"));
    }
    addRefsForBuff(buffId, entryIds);
  }

  for (const ignored of observedBridge?.ignoredBuffIds || []) {
    const buffId = toPositiveNumber(ignored?.buffId ?? ignored);
    if (buffId === null) continue;
    if (!byBuffId[String(buffId)]?.length && !ignoredBuffIds.has(buffId)) {
      ignoredBuffIds.add(buffId);
      observedBridgeStats.ignoredBuffIds += 1;
    }
  }

  function applyObservedBridgeAliases() {
    for (const [buffIdText, aliases] of Object.entries(observedBridge?.aliasesByBuffId || {})) {
      const buffId = toPositiveNumber(buffIdText);
      if (buffId === null || ignoredBuffIds.has(buffId)) continue;
      const entryIds = [];
      const parentBuffIds = [];
      for (const alias of aliases || []) {
        for (const parentBuffId of sortedNumbers(alias?.parentBuffIds)) {
          parentBuffIds.push(parentBuffId);
          entryIds.push(...(byBuffId[String(parentBuffId)] || []));
        }
      }
      if (entryIds.length === 0 && parentBuffIds.length > 0 && parentBuffIds.every((parentBuffId) => ignoredBuffIds.has(parentBuffId))) {
        ignoredBuffIds.add(buffId);
        observedBridgeStats.ignoredBuffIds += 1;
        continue;
      }
      const added = addRefsForBuff(buffId, entryIds);
      if (added > 0) {
        observedBridgeStats.aliasBuffIds += 1;
        observedBridgeStats.aliasRefs += added;
        if (entryIds.some((entryId) => sourcesById[entryId]?.reportPolicy === "include")) {
          reportableBuffIds.add(buffId);
        } else if (entryIds.length > 0) {
          debugBuffIds.add(buffId);
        }
      }
    }
  }

  function addObservedOnlyBuffSources() {
    const stats = {
      sourceBuffIds: 0,
      sourceRefs: 0,
      sourceTypeCounts: {},
    };
    for (const row of buffRows || []) {
      const buffId = toPositiveNumber(row?.Id ?? row?.id);
      if (buffId === null) continue;
      if (ignoredBuffIds.has(buffId)) continue;
      if ((byBuffId[String(buffId)] || []).length > 0) continue;
      if ((sourceIndex.byBuffId?.[String(buffId)] || []).length > 0) continue;
      if (!isObservedOnlySourceCandidate(row)) continue;

      const rawEntry = observedOnlyBuffSourceEntry(row, buffId);
      const entryId = addRecountEntry(buffId, rawEntry, "observed-only-buffname");
      const added = addRefsForBuff(buffId, [entryId]);
      if (added > 0) {
        stats.sourceBuffIds += 1;
        stats.sourceRefs += added;
        stats.sourceTypeCounts[rawEntry.sourceType] = (stats.sourceTypeCounts[rawEntry.sourceType] || 0) + 1;
      }
    }
    return stats;
  }

  applyObservedBridgeAliases();
  const aliasStats = buildSiblingBuffAliases(buffRows, byBuffId, sourcesById, reportableBuffIds, ignoredBuffIds);
  const stateSiblingAliasStats = buildStateSiblingBuffAliases(
    buffRows,
    byBuffId,
    sourcesById,
    relationshipsByRuleId,
    debugBuffIds,
    ignoredBuffIds,
  );
  const observedOnlyIgnoredBuffIds = addObservedOnlyIgnoredBuffIds(buffRows, sourceIndex, ignoredBuffIds);
  applyObservedBridgeAliases();
  const observedOnlySourceStats = addObservedOnlyBuffSources();
  const relationshipStats = relationshipEdgeStats(relationshipsByRuleId);
  const ownershipStats = talentOwnershipStats(sourcesById);
  for (const [entryId, entry] of Object.entries(sourcesById)) {
    for (const zoneId of entry.formulaZoneIds || []) {
      byFormulaZoneId[zoneId] ||= [];
      byFormulaZoneId[zoneId].push(entryId);
    }
  }
  for (const zoneId of Object.keys(byFormulaZoneId)) {
    byFormulaZoneId[zoneId] = uniqueStrings(byFormulaZoneId[zoneId]);
  }

  const tableStats = {
    buffIds: Object.keys(byBuffId).length,
    sourceRules: Object.keys(sourcesById).length,
    sourceRuleRefs: Object.values(byBuffId).reduce((sum, refs) => sum + refs.length, 0),
    reportableBuffIds: reportableBuffIds.size,
    debugBuffIds: debugBuffIds.size,
    ignoredBuffIds: ignoredBuffIds.size,
    siblingAliasBuffIds: aliasStats.aliasBuffIds,
    siblingAliasRefs: aliasStats.aliasRefs,
    stateSiblingAliasBuffIds: stateSiblingAliasStats.aliasBuffIds,
    stateSiblingAliasRefs: stateSiblingAliasStats.aliasRefs,
    stateSiblingAliasEdges: stateSiblingAliasStats.aliasEdges,
    observedOnlyIgnoredBuffIds,
    observedOnlySourceBuffIds: observedOnlySourceStats.sourceBuffIds,
    observedOnlySourceRefs: observedOnlySourceStats.sourceRefs,
    observedOnlySourceTypeCounts: observedOnlySourceStats.sourceTypeCounts,
    observedBridgePromotedSources: observedBridgeStats.promotedSources,
    observedBridgeAliasBuffIds: observedBridgeStats.aliasBuffIds,
    observedBridgeAliasRefs: observedBridgeStats.aliasRefs,
    observedBridgeIgnoredBuffIds: observedBridgeStats.ignoredBuffIds,
    sourceIndexReportPolicyCounts: sourceIndexPolicyCounts,
    reportPolicyCounts: policyCounts,
    runtimeReportReasonCounts: reportReasonCounts,
    rowPolicyCounts,
    formulaZoneCounts: formulaZoneCounts(Object.values(sourcesById)),
    talentOwnership: ownershipStats,
    uidEdges: relationshipStats.uidEdges,
    uidEdgeKindCounts: relationshipStats.uidEdgeKindCounts,
    uidEdgeRoleCounts: relationshipStats.uidEdgeRoleCounts,
  };

  return {
    table: {
      schemaVersion: 1,
      generatedBy: "ModifierRecountTable.gen",
      sourcesById,
      byBuffId,
      byFormulaZoneId,
      formulaZoneContract: compactFormulaZoneContract(formulaZoneContract),
      reportableBuffIds: sortedNumbers(reportableBuffIds),
      debugBuffIds: sortedNumbers(debugBuffIds),
      ignoredBuffIds: sortedNumbers(ignoredBuffIds),
      stats: tableStats,
    },
    relationshipTable: {
      schemaVersion: 1,
      generatedBy: "ModifierRecountTable.gen",
      sourceTable: "ModifierRecountTable.json",
      sourcesByRuleId: relationshipsByRuleId,
      stats: relationshipStats,
    },
  };
}

function main() {
  const args = parseArgs(process.argv.slice(2));
  if (args.help) {
    printHelp();
    return;
  }

  const sourceIndex = readJson(args.sourceIndexPath);
  const observedBridge = readOptionalJson(args.observedBridgePath, null);
  const buffRows = fs.existsSync(args.buffNamePath) ? readJson(args.buffNamePath) : [];
  const recountTable = fs.existsSync(args.recountTablePath) ? readJson(args.recountTablePath) : {};
  const formulaZoneContract = readOptionalJson(args.formulaZoneContractPath, {});
  const { table, relationshipTable } = buildRecountTable(sourceIndex, observedBridge, buffRows, recountTable, formulaZoneContract);
  if (!args.dryRun) {
    writeJson(args.outPath, table);
    writeJson(args.relationshipOutPath, relationshipTable);
  }
  console.log(JSON.stringify({
    out: args.outPath,
    relationshipOut: args.relationshipOutPath,
    dryRun: args.dryRun,
    stats: table.stats,
    relationshipStats: relationshipTable.stats,
  }, null, 2));
}

main();
